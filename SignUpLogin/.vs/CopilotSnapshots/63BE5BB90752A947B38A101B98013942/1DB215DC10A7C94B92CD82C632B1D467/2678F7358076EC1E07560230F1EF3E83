@{
    ViewData["Title"] = "Admin Home";
    Layout = null;
    var today = DateTime.Now.ToString("MMMM dd, yyyy");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_UserNavBar")

    <div class="container py-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="mb-1">Welcome, @ViewBag.UserName</h3>
                <p class="text-muted mb-4">@today</p>
                <p class="mb-0">You are logged in as an administrator.</p>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
