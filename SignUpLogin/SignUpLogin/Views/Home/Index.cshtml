@model SignUpLogin.Models.ViewModels.StudentHomeViewModel
@{
    ViewData["Title"] = "Student Home";
    Layout = null;
    var today = DateTime.Now.ToString("MMMM dd, yyyy");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    @await Html.PartialAsync("_UserNavBar")

    <div class="dash-wrapper">
        <div class="student-home container py-4 py-md-5">
            <div class="profile-panel mb-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-3 text-center">
                        <div class="avatar-wrap mx-auto">
                            <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? "/images/default-avatar.png" : Model.ProfileImagePath)"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@Model.UserName&background=0b4a94&color=fff&size=160&bold=true'"
                                 alt="Student avatar" class="avatar-img" />
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="info-box">
                            <div class="row g-3">
                                <div class="col-lg-7">
                                    <h3 class="mb-3">@Model.UserName</h3>
                                    <p class="mb-1"><strong>ID Number:</strong> @Model.IdNumber</p>
                                    <p class="mb-1"><strong>Year Level:</strong> @Model.CourseLevel</p>
                                    <p class="mb-1"><strong>Course:</strong> @Model.Course</p>
                                    <p class="mb-0"><strong>Email:</strong> @Model.Email</p>
                                </div>
                                <div class="col-lg-5 text-lg-end d-flex flex-column justify-content-between">
                                    <div class="d-flex flex-column align-items-lg-end gap-2">
                                        <div class="sessions-chip align-self-lg-end">Sessions Remaining: <strong>@Model.RemainingSessions</strong></div>
                                        @if (Model.IsCurrentlyActive && Model.ActiveSitIn != null)
                                        {
                                            <div class="sitin-status-chip active">
                                                <span class="sitin-dot"></span>
                                                <span>Sit-in: <strong>Active</strong></span>
                                            </div>
                                            <div class="sitin-details">
                                                <p class="mb-0"><strong>Lab:</strong> @Model.ActiveSitIn.Laboratory</p>
                                                <p class="mb-0"><strong>Time In:</strong> @Model.ActiveSitIn.TimeIn.ToString("hh:mm tt")</p>
                                                <p class="mb-0"><strong>Purpose:</strong> @Model.ActiveSitIn.Purpose</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="sitin-status-chip inactive">
                                                <span class="sitin-dot"></span>
                                                <span>Sit-in: <strong>Not Active</strong></span>
                                            </div>
                                        }
                                    </div>
                                    <p class="mb-0 mt-3 mt-lg-0"><strong>Date:</strong> @today</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Laboratory Availability ── -->
            <div class="panel-card mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="panel-title mb-0">Laboratory Availability</h5>
                    <span class="text-muted small">Click a lab to view PC availability</span>
                </div>

                <!-- Status legend -->
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="lab-legend lab-legend-available"><span class="lab-legend-dot"></span>Available</span>
                    <span class="lab-legend lab-legend-class"><span class="lab-legend-dot"></span>Class is in session</span>
                    <span class="lab-legend lab-legend-maintenance"><span class="lab-legend-dot"></span>Maintenance</span>
                    <span class="lab-legend lab-legend-unavailable"><span class="lab-legend-dot"></span>Unavailable</span>
                </div>

                <div class="lab-grid">
                    @foreach (var lab in Model.LabStatuses)
                    {
                        var statusLower = lab.Status.ToLower();
                        var cardClass = statusLower switch
                        {
                            "class is in session" => "lab-class",
                            "maintenance"         => "lab-maintenance",
                            "unavailable"         => "lab-unavailable",
                            _                     => "lab-available"
                        };
                        <div class="lab-card @cardClass lab-clickable"
                             onclick="openLabModal('@lab.LabName', '@lab.Status', '@Html.Raw((lab.Remarks ?? "").Replace("'", "\\'"))')">
                            <div class="lab-number">@lab.LabName</div>
                            <div class="lab-status-row">
                                <span class="lab-dot-sm"></span>
                                <span class="lab-status-text">@lab.Status</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lab.Remarks))
                            {
                                <div class="lab-remarks">@lab.Remarks</div>
                            }
                            <div class="lab-click-hint"><i class="bi bi-display me-1"></i>View PCs</div>
                        </div>
                    }
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-6" id="announcements">
                    <div class="panel-card h-100">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="panel-title mb-0">Announcements</h5>
                            @if (Model.UnreadAnnouncementsCount > 0)
                            {
                                <span class="badge text-bg-danger">@Model.UnreadAnnouncementsCount unread</span>
                            }
                        </div>

                        @if (Model.Announcements.Any())
                        {
                            @foreach (var announcement in Model.Announcements)
                            {
                                <div class="announcement-item">
                                    <div class="announcement-meta">@announcement.PostedBy | @announcement.PostedAt.ToLocalTime().ToString("yyyy-MMM-dd")</div>
                                    <div><strong>@announcement.Title</strong></div>
                                    <div>@announcement.Message</div>
                                </div>
                            }

                            <form asp-controller="Home" asp-action="MarkAnnouncementsRead" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Mark all as read</button>
                            </form>
                        }
                        else
                        {
                            <div class="empty-state">No announcements yet. New updates from admin will appear here.</div>
                        }
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="panel-card h-100">
                        <h5 class="panel-title">Recent Sit-in History</h5>
                        @if (Model.RecentSitInHistory.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Lab</th>
                                            <th>Time In</th>
                                            <th>Time Out</th>
                                            <th>Duration</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.RecentSitInHistory)
                                        {
                                            var duration = item.TimeOut.HasValue ? item.TimeOut.Value - item.TimeIn : (TimeSpan?)null;
                                            <tr>
                                                <td>@item.TimeIn.ToString("yyyy-MM-dd")</td>
                                                <td>@item.Laboratory</td>
                                                <td>@item.TimeIn.ToString("hh:mm tt")</td>
                                                <td>@(item.TimeOut?.ToString("hh:mm tt") ?? "In Progress")</td>
                                                <td>@(duration.HasValue ? $"{(int)duration.Value.TotalHours}h {duration.Value.Minutes}m" : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">No sit-in history yet. Your latest 5 sessions will show here.</div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    @if (TempData["LoginSuccess"] != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)" id="loginSuccessModal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center p-4">
                    <div class="mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="#28a745" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                    </div>
                    <h5 class="fw-bold">Login Successful!</h5>
                    <p class="text-muted small">@TempData["LoginSuccess"]</p>
                    <button class="btn btn-success mt-2 px-4" onclick="this.closest('.modal').remove()">Continue</button>
                </div>
            </div>
        </div>
    }

    <!-- ── Lab PC Modal ── -->
    <div class="modal fade" id="pcModal" tabindex="-1" aria-labelledby="pcModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="border-bottom:1px solid #e5e7eb;">
                    <div>
                        <h5 class="modal-title fw-bold" id="pcModalLabel" style="color:#0b4a94;">
                            <i class="bi bi-pc-display me-2"></i><span id="modalLabName">Lab</span> &mdash; PC Availability
                        </h5>
                        <p class="mb-1 mt-1" id="modalLabStatusRow" style="font-size:0.82rem;"></p>
                        <p class="mb-0" style="font-size:0.78rem;color:#64748b;">
                            <span class="pc-legend pc-legend-free"></span>&nbsp;Free &nbsp;&nbsp;
                            <span class="pc-legend pc-legend-used"></span>&nbsp;In Use
                        </p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="pcLoadingSpinner" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted small mt-2">Loading PC availability…</p>
                    </div>
                    <div id="pcGrid" class="pc-grid"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const pcModal = new bootstrap.Modal(document.getElementById('pcModal'));

        // Status → badge style mapping (mirrors admin colour scheme)
        const statusBadgeMap = {
            'available':           { cls: 'badge-available',     label: 'Available' },
            'class is in session': { cls: 'badge-class',         label: 'Class is in session' },
            'maintenance':         { cls: 'badge-maintenance',   label: 'Maintenance' },
            'unavailable':         { cls: 'badge-unavailable',   label: 'Unavailable' }
        };

        async function openLabModal(labName, labStatus, labRemarks) {
            // Set title
            document.getElementById('modalLabName').textContent = labName;

            // Set status badge
            const statusRow = document.getElementById('modalLabStatusRow');
            const key = (labStatus || '').toLowerCase();
            const badge = statusBadgeMap[key] || { cls: 'badge-available', label: labStatus };
            let remarkHtml = labRemarks ? `<span class="text-muted ms-2" style="font-size:.78rem;">${labRemarks}</span>` : '';
            statusRow.innerHTML = `<span class="lab-status-badge ${badge.cls}">${badge.label}</span>${remarkHtml}`;

            // Clear and show spinner
            const grid = document.getElementById('pcGrid');
            const spinner = document.getElementById('pcLoadingSpinner');
            grid.innerHTML = '';
            spinner.classList.remove('d-none');

            pcModal.show();

            // Fetch live occupied PCs from server
            let occupiedPcs = [];
            try {
                const res  = await fetch(`/Home/GetOccupiedPcs?laboratory=${encodeURIComponent(labName)}`);
                const data = await res.json();
                occupiedPcs = data.occupiedPcs ?? [];
            } catch (e) {
                console.warn('Could not fetch occupied PCs:', e);
            }

            spinner.classList.add('d-none');

            // Build PC grid (PC-1 … PC-49, matching admin format)
            for (let i = 1; i <= 49; i++) {
                const pcId   = 'PC-' + i;
                const isUsed = occupiedPcs.includes(pcId);
                const card   = document.createElement('div');
                card.className = 'pc-card ' + (isUsed ? 'pc-used' : 'pc-free');
                card.innerHTML =
                    '<div class="pc-icon">&#128187;</div>' +
                    '<div class="pc-label">' + pcId + '</div>' +
                    '<div class="pc-status-text">' + (isUsed ? 'In Use' : 'Available') + '</div>';
                grid.appendChild(card);
            }
        }
    </script>
    </body>
</html>

<style>
    html, body {
        margin: 0;
        padding: 0;
        background: #f3f4f6;
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .dash-wrapper {
        flex: 1;
    }

    .student-home {
        max-width: 1100px;
    }

    .profile-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    }

    .avatar-wrap {
        width: 170px;
        height: 170px;
        border: 2px solid #dbeafe;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
    }

    .avatar-img {
        width: 145px;
        height: 145px;
        object-fit: cover;
        border-radius: 50%;
        background: #fff;
    }

    .info-box {
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 18px 20px;
        background: #fff;
    }

    .sessions-chip {
        background: #eaf2ff;
        color: #0b4a94;
        border: 1px solid #bfdbfe;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.95rem;
    }

    .sitin-status-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.9rem;
    }

        .sitin-status-chip.active {
            background: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .sitin-status-chip.inactive {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

    .sitin-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .sitin-status-chip.active .sitin-dot {
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34,197,94,0.2);
    }

    .sitin-status-chip.inactive .sitin-dot {
        background: #ef4444;
    }

    .sitin-details {
        font-size: 0.82rem;
        color: #374151;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 8px 12px;
        text-align: left;
        line-height: 1.7;
    }

    .panel-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 18px;
    }

    .panel-title {
        color: #0b4a94;
        font-weight: 700;
        margin-bottom: 14px;
    }

    /* ── Lab status legend ── */
    .lab-legend {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .78rem;
        font-weight: 600;
    }

    .lab-legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .lab-legend-available .lab-legend-dot { background: #22c55e; }
    .lab-legend-available { color: #15803d; }

    .lab-legend-class .lab-legend-dot { background: #3b82f6; }
    .lab-legend-class { color: #1d4ed8; }

    .lab-legend-maintenance .lab-legend-dot { background: #f59e0b; }
    .lab-legend-maintenance { color: #b45309; }

    .lab-legend-unavailable .lab-legend-dot { background: #ef4444; }
    .lab-legend-unavailable { color: #b91c1c; }

    /* ── Lab grid ── */
    .lab-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
    }

    .lab-card {
        border-radius: 10px;
        padding: 16px 14px;
        text-align: center;
        border: 1.5px solid;
        position: relative;
    }

    /* Available — green */
    .lab-available {
        background: #f0fdf4;
        border-color: #bbf7d0;
    }
    .lab-available .lab-dot-sm { background: #22c55e; }
    .lab-available .lab-status-text { color: #15803d; }

    /* Class is in session — blue */
    .lab-class {
        background: #eff6ff;
        border-color: #bfdbfe;
    }
    .lab-class .lab-dot-sm { background: #3b82f6; }
    .lab-class .lab-status-text { color: #1d4ed8; }

    /* Maintenance — amber */
    .lab-maintenance {
        background: #fffbeb;
        border-color: #fde68a;
    }
    .lab-maintenance .lab-dot-sm { background: #f59e0b; }
    .lab-maintenance .lab-status-text { color: #b45309; }

    /* Unavailable — red */
    .lab-unavailable {
        background: #fef2f2;
        border-color: #fecaca;
    }
    .lab-unavailable .lab-dot-sm { background: #ef4444; }
    .lab-unavailable .lab-status-text { color: #b91c1c; }

    .lab-number {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }

    .lab-status-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .lab-dot-sm {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .lab-status-text {
        font-size: 0.82rem;
        font-weight: 600;
    }

    .lab-remarks {
        font-size: 0.72rem;
        color: #64748b;
        margin-top: 5px;
        font-style: italic;
    }

    .lab-clickable {
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .lab-clickable:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(11,74,148,0.13);
        }

    .lab-click-hint {
        font-size: 0.72rem;
        color: #94a3b8;
        margin-top: 6px;
        font-style: italic;
    }

    /* ── Modal status badge ── */
    .lab-status-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        border: 1.5px solid;
    }

    .badge-available    { background: #f0fdf4; border-color: #bbf7d0; color: #15803d; }
    .badge-class        { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .badge-maintenance  { background: #fffbeb; border-color: #fde68a; color: #b45309; }
    .badge-unavailable  { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }

    /* ── PC Grid in modal ── */
    .pc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
        gap: 10px;
    }

    .pc-card {
        border-radius: 8px;
        padding: 12px 6px 8px;
        text-align: center;
        border: 1.5px solid;
        user-select: none;
    }

    .pc-free {
        background: #f0fdf4;
        border-color: #bbf7d0;
    }

    .pc-used {
        background: #fef2f2;
        border-color: #fecaca;
        opacity: 0.75;
    }

    .pc-icon {
        font-size: 1.4rem;
        margin-bottom: 4px;
    }

    .pc-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #1e293b;
    }

    .pc-status-text {
        font-size: 0.7rem;
        font-weight: 600;
        margin-top: 3px;
    }

    .pc-free .pc-status-text { color: #15803d; }
    .pc-used .pc-status-text { color: #b91c1c; }

    .pc-legend {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 3px;
        vertical-align: middle;
    }

    .pc-legend-free { background: #22c55e; }
    .pc-legend-used { background: #ef4444; }

    /* ── Announcements & history ── */
    .announcement-item {
        padding-bottom: 10px;
        margin-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

    .announcement-meta {
        font-weight: 600;
        margin-bottom: 4px;
    }

    .empty-state {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 10px;
        padding: 16px;
        color: #475569;
    }

    @@media (max-width: 768px) {
        .lab-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .lab-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    footer {
        margin-top: 0 !important;
    }
</style>
