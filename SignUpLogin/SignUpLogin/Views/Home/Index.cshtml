    <!-- ── Lab PC Modal ── -->
    <div class="modal fade" id="pcModal" tabindex="-1" aria-labelledby="pcModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="border-bottom:1px solid #e5e7eb;">
                    <div>
                        <h5 class="modal-title fw-bold" id="pcModalLabel" style="color:#0b4a94;">
                            <i class="bi bi-pc-display me-2"></i><span id="modalLabName">Lab</span> &mdash; PC Availability
                        </h5>
                        <p class="mb-1 mt-1" id="modalLabStatusRow" style="font-size:0.82rem;"></p>
                        <p class="mb-0" style="font-size:0.78rem;color:#64748b;">
                            <span class="pc-legend pc-legend-free"></span>&nbsp;Free &nbsp;&nbsp;
                            <span class="pc-legend pc-legend-used"></span>&nbsp;In Use
                        </p>
                    </div>
                    <div class="d-flex align-items-center ms-auto">
                        <a id="modalReserveBtn" href="/Home/Reservations" class="btn btn-primary btn-sm me-3 fw-semibold py-2 px-3 shadow-sm" style="border-radius: 8px;">
                            <i class="bi bi-calendar-plus me-1"></i>Reserve a Sit-In
                        </a>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div id="pcLoadingSpinner" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted small mt-2">Loading PC availability…</p>
                    </div>
                    <div id="pcGrid" class="pc-grid"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const labPcCountMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabStatuses.ToDictionary(l => l.LabName, l => l.TotalPCs)));
        const pcModal = new bootstrap.Modal(document.getElementById('pcModal'));

        // Status → badge style mapping (mirrors admin colour scheme)
        const statusBadgeMap = {
            'available':           { cls: 'badge-available',     label: 'Available' },
            'class is in session': { cls: 'badge-class',         label: 'Class is in session' },
            'maintenance':         { cls: 'badge-maintenance',   label: 'Maintenance' },
            'unavailable':         { cls: 'badge-unavailable',   label: 'Unavailable' }
        };

        async function openLabModal(labName, labStatus, labRemarks) {
            // Set title
            document.getElementById('modalLabName').textContent = labName;

            // Set status badge
            const statusRow = document.getElementById('modalLabStatusRow');
            const key = (labStatus || '').toLowerCase();
            const badge = statusBadgeMap[key] || { cls: 'badge-available', label: labStatus };
            let remarkHtml = labRemarks ? `<span class="text-muted ms-2" style="font-size:.78rem;">${labRemarks}</span>` : '';
            statusRow.innerHTML = `<span class="lab-status-badge ${badge.cls}">${badge.label}</span>${remarkHtml}`;

            // Update general reserve button link
            document.getElementById('modalReserveBtn').href = '/Home/Reservations?laboratory=' + encodeURIComponent(labName);

            // Clear and show spinner
            const grid = document.getElementById('pcGrid');
            const spinner = document.getElementById('pcLoadingSpinner');
            grid.innerHTML = '';
            spinner.classList.remove('d-none');

            pcModal.show();

            // Fetch live occupied PCs from server
            let occupiedPcs = [];
            try {
                const res  = await fetch(`/Home/GetOccupiedPcs?laboratory=${encodeURIComponent(labName)}`);
                const data = await res.json();
                occupiedPcs = data.occupiedPcs ?? [];
            } catch (e) {
                console.warn('Could not fetch occupied PCs:', e);
            }

            spinner.classList.add('d-none');

            // Build PC grid dynamically based on total lab PC capacity (default to 49 for legacy)
            const totalPCs = labPcCountMap[labName] || 49;
            for (let i = 1; i <= totalPCs; i++) {
                const pcId   = 'PC-' + i;
                const isUsed = occupiedPcs.includes(pcId);
                const card   = document.createElement('div');
                card.className = 'pc-card ' + (isUsed ? 'pc-used' : 'pc-free');
                card.innerHTML =
                    '<div class="pc-icon">&#128187;</div>' +
                    '<div class="pc-label">' + pcId + '</div>' +
                    '<div class="pc-status-text">' + (isUsed ? 'In Use' : 'Available') + '</div>';
                
                if (!isUsed) {
                    card.style.cursor = 'pointer';
                    card.title = `Click to reserve ${pcId} in ${labName}!`;
                    card.onclick = () => {
                        window.location.href = '/Home/Reservations?laboratory=' + encodeURIComponent(labName) + '&pc=' + encodeURIComponent(pcId);
                    };
                }
                
                grid.appendChild(card);
            }
        }
        function updateRedeemPreview(value) {
            const pts      = parseInt(value) || 0;
            const valid    = Math.floor(pts / 2) * 2;
            const sessions = valid / 2;
            const preview  = document.getElementById('redeemPreview');
            if (preview) {
                preview.innerHTML = valid >= 2
                    ? `= <strong>${sessions}</strong> session${sessions !== 1 ? 's' : ''}`
                    : '<span class="text-danger">min 2 pts</span>';
            }
        }
    </script>
</body>
</html>

