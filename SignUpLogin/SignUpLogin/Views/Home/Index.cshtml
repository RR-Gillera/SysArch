@model SignUpLogin.Models.ViewModels.StudentHomeViewModel
@{
    ViewData["Title"] = "Student Home";
    Layout = null;
    var today = DateTime.Now.ToString("MMMM dd, yyyy");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    @await Html.PartialAsync("_UserNavBar")

    <div class="dash-wrapper">
        <div class="student-home container py-4 py-md-5">
            <div class="profile-panel mb-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-3 text-center">
                        <div class="avatar-wrap mx-auto">
                            <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? "/images/default-avatar.png" : Model.ProfileImagePath)"
                                 onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Model.UserName&background=0b4a94&color=fff&size=160&bold=true';"
                                 alt="Student avatar" class="avatar-img" />
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="info-box">
                            <div class="row g-3">
                                <div class="col-lg-7">
                                    <h3 class="mb-3">@Model.UserName</h3>
                                    <p class="mb-1"><strong>ID Number:</strong> @Model.IdNumber</p>
                                    <p class="mb-1"><strong>Year Level:</strong> @Model.CourseLevel</p>
                                    <p class="mb-1"><strong>Course:</strong> @Model.Course</p>
                                    <p class="mb-0"><strong>Email:</strong> @Model.Email</p>
                                </div>
                                <div class="col-lg-5 text-lg-end d-flex flex-column justify-content-between">
                                    <div class="d-flex flex-column align-items-lg-end gap-2">
                                        <div class="sessions-chip align-self-lg-end">Sessions Remaining: <strong>@Model.RemainingSessions</strong></div>
                                        @if (Model.IsCurrentlyActive && Model.ActiveSitIn != null)
                                        {
                                            <div class="sitin-status-chip active">
                                                <span class="sitin-dot"></span>
                                                <span>Sit-in: <strong>Active</strong></span>
                                            </div>
                                            <div class="sitin-details">
                                                <p class="mb-0"><strong>Lab:</strong> @Model.ActiveSitIn.Laboratory</p>
                                                <p class="mb-0"><strong>Time In:</strong> @Model.ActiveSitIn.TimeIn.ToString("hh:mm tt")</p>
                                                <p class="mb-0"><strong>Purpose:</strong> @Model.ActiveSitIn.Purpose</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="sitin-status-chip inactive">
                                                <span class="sitin-dot"></span>
                                                <span>Sit-in: <strong>Not Active</strong></span>
                                            </div>
                                        }
                                    </div>
                                    <p class="mb-0 mt-3 mt-lg-0"><strong>Date:</strong> @today</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Laboratory Availability ── -->
            <div class="panel-card mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="panel-title mb-0">Laboratory Availability</h5>
                    <span class="text-muted small">Click a lab to view PC availability</span>
                </div>

                <!-- Status legend -->
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="lab-legend lab-legend-available"><span class="lab-legend-dot"></span>Available</span>
                    <span class="lab-legend lab-legend-class"><span class="lab-legend-dot"></span>Class is in session</span>
                    <span class="lab-legend lab-legend-maintenance"><span class="lab-legend-dot"></span>Maintenance</span>
                    <span class="lab-legend lab-legend-unavailable"><span class="lab-legend-dot"></span>Unavailable</span>
                </div>

                <div class="lab-grid">
                    @foreach (var lab in Model.LabStatuses)
                    {
                        var statusLower = lab.Status.ToLower();
                        var cardClass = statusLower switch
                        {
                            "class is in session" => "lab-class",
                            "maintenance" => "lab-maintenance",
                            "unavailable" => "lab-unavailable",
                            _ => "lab-available"
                        };
                        <div class="lab-card @cardClass lab-clickable"
                             onclick="openLabModal('@lab.LabName', '@lab.Status', '@Html.Raw((lab.Remarks ?? "").Replace("'", "\\'"))')">
                            <div class="lab-number">@lab.LabName</div>
                            <div class="lab-status-row">
                                <span class="lab-dot-sm"></span>
                                <span class="lab-status-text">@lab.Status</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lab.Remarks))
                            {
                                <div class="lab-remarks">@lab.Remarks</div>
                            }
                            <div class="lab-click-hint"><i class="bi bi-display me-1"></i>View PCs</div>
                        </div>
                    }
                </div>
            </div>

            <!-- ── Rules & Regulations ── -->
            <div class="panel-card mb-4">
                <h5 class="panel-title mb-3"><i class="bi bi-journal-text me-2"></i>Rules &amp; Regulations</h5>
                <ul class="nav nav-tabs mb-3" id="rulesTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="sitin-tab" data-bs-toggle="tab" data-bs-target="#sitin-rules" type="button" role="tab" aria-controls="sitin-rules" aria-selected="true">
                            <i class="bi bi-person-check me-1"></i>Sit-in Rules
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="lab-tab" data-bs-toggle="tab" data-bs-target="#lab-rules" type="button" role="tab" aria-controls="lab-rules" aria-selected="false">
                            <i class="bi bi-pc-display me-1"></i>Laboratory Rules
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="rulesTabContent">

                    <!-- Sit-in Rules -->
                    <div class="tab-pane fade show active" id="sitin-rules" role="tabpanel" aria-labelledby="sitin-tab">
                        <div class="rules-header">
                            <p class="rules-institution">University of Cebu &mdash; College of Information &amp; Computer Studies</p>
                            <h6 class="rules-section-title">SIT-IN RULES AND REGULATIONS</h6>
                            <p class="rules-intro">To ensure a conducive and respectful learning environment for all, please adhere to the following Sit-In rules:</p>
                        </div>
                        <ol class="rules-list">
                            <li>Only authorized sit-in students with prior approval from the instructor are allowed.</li>
                            <li>Sit-in students must not disrupt the class or engage in side conversations.</li>
                            <li>Mobile phones and other electronic devices must be set to silent mode during the session.</li>
                            <li>Sit-in students must not use laboratory computers unless explicitly permitted by the instructor.</li>
                            <li>Seats are prioritized for officially enrolled students. Sit-in students should occupy vacant seats only.</li>
                            <li>Participation in discussions or activities is allowed only if the instructor permits.</li>
                            <li>Eating, drinking, or any form of littering is strictly prohibited inside the classroom.</li>
                            <li>Sit-in students must follow the instructor&rsquo;s guidelines and classroom rules at all times.</li>
                            <li>Disruptive behavior, including excessive talking, arguing, or any form of distraction, will not be tolerated.</li>
                            <li>Failure to follow these rules may result in the immediate removal from the class and possible restrictions on future sit-in requests.</li>
                        </ol>
                        <div class="rules-disciplinary">
                            <h6 class="rules-disciplinary-title"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>Disciplinary Action</h6>
                            <div class="d-flex flex-column gap-2">
                                <div class="disciplinary-item offense-1">
                                    <span class="offense-badge">1st Offense</span>
                                    A verbal warning will be issued by the instructor.
                                </div>
                                <div class="disciplinary-item offense-2">
                                    <span class="offense-badge">2nd Offense</span>
                                    The student will be asked to leave and reported to the administration.
                                </div>
                                <div class="disciplinary-item offense-3">
                                    <span class="offense-badge">3rd Offense</span>
                                    A formal complaint may be filed, leading to further disciplinary actions.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Laboratory Rules -->
                    <div class="tab-pane fade" id="lab-rules" role="tabpanel" aria-labelledby="lab-tab">
                        <div class="rules-header">
                            <p class="rules-institution">University of Cebu &mdash; College of Information &amp; Computer Studies</p>
                            <h6 class="rules-section-title">LABORATORY RULES AND REGULATIONS</h6>
                            <p class="rules-intro">To avoid embarrassment and maintain camaraderie with your friends and superiors at our laboratories, please observe the following:</p>
                        </div>
                        <ol class="rules-list">
                            <li>Maintain silence, proper decorum, and discipline inside the laboratory.</li>
                            <li>Mobile phones, walkmans and other personal pieces of equipment must be switched off.</li>
                            <li>Games are not allowed inside the lab. This includes computer-related games, card games and other games that may disturb the operation of the lab.</li>
                            <li>Surfing the Internet is allowed only with the permission of the instructor.</li>
                            <li>Downloading and installing of software are strictly prohibited.</li>
                            <li>Getting access to other websites not related to the course (especially pornographic and illicit sites) is strictly prohibited.</li>
                            <li>Deleting computer files and changing the set-up of the computer is a major offense.</li>
                            <li>Observe computer time usage carefully. A fifteen-minute allowance is given for each use. Otherwise, the unit will be given to those who wish to &ldquo;sit-in&rdquo;.</li>
                            <li>Observe proper decorum while inside the laboratory. Do not get inside the lab unless the instructor is present.</li>
                            <li>All bags, knapsacks, and the likes must be deposited at the counter.</li>
                            <li>Follow the seating arrangement of your instructor.</li>
                            <li>At the end of class, all software programs must be closed. Return all chairs to their proper places after using.</li>
                            <li>Chewing gum, eating, drinking, smoking, and other forms of vandalism are prohibited inside the lab.</li>
                            <li>Anyone causing a continual disturbance will be asked to leave the lab.</li>
                            <li>Acts or gestures offensive to the members of the community, including public display of physical intimacy, are not tolerated.</li>
                            <li>Persons exhibiting hostile or threatening behavior such as yelling, swearing, or disregarding requests made by lab personnel will be asked to leave the lab. For serious offense, the lab personnel may call the Civil Security Office (CSU) for assistance.</li>
                            <li>Any technical problem or difficulty must be addressed to the laboratory supervisor, student assistant or instructor immediately.</li>
                        </ol>
                        <div class="rules-disciplinary">
                            <h6 class="rules-disciplinary-title"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>Disciplinary Action</h6>
                            <div class="d-flex flex-column gap-2">
                                <div class="disciplinary-item offense-1">
                                    <span class="offense-badge">1st Offense</span>
                                    The Head or the Dean or OIC recommends to the Guidance Center for a suspension from classes for each offender.
                                </div>
                                <div class="disciplinary-item offense-2">
                                    <span class="offense-badge">2nd &amp; Subsequent Offenses</span>
                                    A recommendation for a heavier sanction will be endorsed to the Guidance Center.
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Announcements Panel -->
                <div class="col-lg-6" id="announcements">
                    <div class="panel-card h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2 flex-shrink-0">
                            <h5 class="panel-title mb-0">Announcements</h5>
                            @if (Model.UnreadAnnouncementsCount > 0)
                            {
                                <span class="badge text-bg-danger">@Model.UnreadAnnouncementsCount unread</span>
                            }
                        </div>

                        <!-- Scrollable Content Area -->
                        <div class="flex-grow-1 overflow-auto custom-scroll" style="max-height: 300px; min-height: 150px;">
                            @if (Model.Announcements.Any())
                            {
                                @foreach (var announcement in Model.Announcements)
                                {
                                    <div class="announcement-item">
                                        <div class="announcement-meta">@announcement.PostedBy | @announcement.PostedAt.ToLocalTime().ToString("yyyy-MMM-dd")</div>
                                        <div><strong>@announcement.Title</strong></div>
                                        <div>@announcement.Message</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state">No announcements yet. New updates from admin will appear here.</div>
                            }
                        </div>

                        <!-- Fixed Footer Button -->
                        @if (Model.Announcements.Any())
                        {
                            <div class="mt-2 flex-shrink-0">
                                <form asp-controller="Home" asp-action="MarkAnnouncementsRead" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">Mark all as read</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>

                <!-- Recent Sit-in History Panel -->
                <div class="col-lg-6">
                    <div class="panel-card h-100 d-flex flex-column">
                        <h5 class="panel-title flex-shrink-0">Recent Sit-in History</h5>

                        <!-- Scrollable Content Area -->
                        <div class="flex-grow-1 overflow-auto custom-scroll" style="max-height: 300px; min-height: 150px;">
                            @if (Model.RecentSitInHistory.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="sticky-top bg-white">
                                            <tr>
                                                <th>Date</th>
                                                <th>Lab</th>
                                                <th>Time In</th>
                                                <th>Time Out</th>
                                                <th>Duration</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.RecentSitInHistory)
                                            {
                                                var duration = item.TimeOut.HasValue ? item.TimeOut.Value - item.TimeIn : (TimeSpan?)null;
                                                <tr>
                                                    <td>@item.TimeIn.ToString("yyyy-MM-dd")</td>
                                                    <td>@item.Laboratory</td>
                                                    <td>@item.TimeIn.ToString("hh:mm tt")</td>
                                                    <td>@(item.TimeOut?.ToString("hh:mm tt") ?? "In Progress")</td>
                                                    <td>@(duration.HasValue ? $"{(int)duration.Value.TotalHours}h {duration.Value.Minutes}m" : "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="empty-state">No sit-in history yet. Your latest 5 sessions will show here.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Rewards & Points ── -->
            @{
                var lifetimePts = Model.LifetimePoints;
                var spendablePts = Model.Points;
                string tierName, tierIcon, tierColor, tierBg, tierBorder;
                int tierMin, tierMax;

                if (lifetimePts >= 90)
                {
                    tierName = "Gold"; tierIcon = "bi-trophy-fill"; tierColor = "#b45309"; tierBg = "#fffbeb"; tierBorder = "#fde68a";
                    tierMin = 90; tierMax = 999;
                }
                else if (lifetimePts >= 60)
                {
                    tierName = "Silver"; tierIcon = "bi-award-fill"; tierColor = "#475569"; tierBg = "#f8fafc"; tierBorder = "#cbd5e1";
                    tierMin = 60; tierMax = 89;
                }
                else if (lifetimePts >= 30)
                {
                    tierName = "Bronze"; tierIcon = "bi-award-fill"; tierColor = "#92400e"; tierBg = "#fff7ed"; tierBorder = "#fed7aa";
                    tierMin = 30; tierMax = 59;
                }
                else
                {
                    tierName = "Starter"; tierIcon = "bi-star-fill"; tierColor = "#1d4ed8"; tierBg = "#eff6ff"; tierBorder = "#bfdbfe";
                    tierMin = 0; tierMax = 29;
                }

                int progressRange = tierName == "Gold" ? 1 : (tierMax - tierMin + 1);
                int progressVal = lifetimePts - tierMin;
                int progressPct = tierName == "Gold" ? 100 : (int)Math.Round((double)progressVal / progressRange * 100);
                int ptsToNext = tierName == "Gold" ? 0 : (tierMax + 1 - lifetimePts);

                // Redeem helpers: 2 pts = 1 session
                int maxRedeemableSessions = spendablePts / 2;
                int maxRedeemablePoints = maxRedeemableSessions * 2;
            }

            <div class="panel-card mb-4" style="border-color:@tierBorder; background:@tierBg;">
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <h5 class="panel-title mb-0"><i class="bi bi-gift-fill me-2"></i>Rewards &amp; Points</h5>
                    <span class="tier-badge" style="background:@tierBg; border-color:@tierBorder; color:@tierColor;">
                        <i class="bi @tierIcon me-1"></i>@tierName Tier
                    </span>
                </div>

                <!-- Tier progression track -->
                <div class="tier-track mb-3">
                    <div class="tier-step @(lifetimePts >= 0 ? "tier-active" : "")">
                        <div class="tier-dot"><i class="bi bi-star-fill"></i></div>
                        <div class="tier-label">Starter<br /><span>0 pts</span></div>
                    </div>
                    <div class="tier-line @(lifetimePts >= 30 ? "tier-line-done" : "")"></div>
                    <div class="tier-step @(lifetimePts >= 30 ? "tier-active" : "")">
                        <div class="tier-dot"><i class="bi bi-award-fill"></i></div>
                        <div class="tier-label">Bronze<br /><span>30 pts</span></div>
                    </div>
                    <div class="tier-line @(lifetimePts >= 60 ? "tier-line-done" : "")"></div>
                    <div class="tier-step @(lifetimePts >= 60 ? "tier-active" : "")">
                        <div class="tier-dot"><i class="bi bi-award-fill"></i></div>
                        <div class="tier-label">Silver<br /><span>60 pts</span></div>
                    </div>
                    <div class="tier-line @(lifetimePts >= 90 ? "tier-line-done" : "")"></div>
                    <div class="tier-step @(lifetimePts >= 90 ? "tier-active" : "")">
                        <div class="tier-dot"><i class="bi bi-trophy-fill"></i></div>
                        <div class="tier-label">Gold<br /><span>90 pts</span></div>
                    </div>
                </div>

                <div class="row g-4 align-items-start">

                    <!-- Left: points circle + progress -->
                    <div class="col-md-4 text-center">
                        <div class="points-circle mx-auto" style="border-color:@tierBorder; color:@tierColor;">
                            <div class="points-number">@spendablePts</div>
                            <div class="points-label">Available Points</div>
                        </div>
                        <div class="mt-2" style="font-size:0.78rem; color:#64748b;">
                            <i class="bi bi-clock me-1"></i>1 pt per 2 hrs of sit-in
                        </div>
                    </div>

                    <!-- Right: progress + last reason + redeem -->
                    <div class="col-md-8">
                        @if (tierName != "Gold")
                        {
                            <p class="mb-1 small text-muted fw-semibold">Progress to next tier</p>
                            <div class="progress mb-1" style="height:12px; border-radius:999px;">
                                <div class="progress-bar" role="progressbar"
                                     style="width:@progressPct%; background:@tierColor; border-radius:999px; transition:width .6s ease;"
                                     aria-valuenow="@progressPct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <p class="mb-3 small" style="color:@tierColor;">
                                <strong>@progressVal / @progressRange pts</strong>
                                &mdash; <strong>@ptsToNext</strong> more to advance
                            </p>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-trophy-fill fs-4" style="color:#f59e0b;"></i>
                                <span class="fw-bold" style="color:#b45309;">You've reached the highest tier — Gold!</span>
                            </div>
                        }

                        <!-- Last reward reason -->
                        @if (!string.IsNullOrWhiteSpace(Model.LastRewardReason))
                        {
                            <div class="reward-reason-box mb-3" style="border-color:@tierBorder;">
                                <i class="bi bi-chat-quote-fill me-2" style="color:@tierColor;"></i>
                                <span><strong>Last activity:</strong> @Model.LastRewardReason</span>
                            </div>
                        }
                        else
                        {
                            <div class="reward-reason-box mb-3" style="border-color:@tierBorder; color:#94a3b8;">
                                <i class="bi bi-info-circle me-2"></i>No rewards yet. Sit-in for 2+ hours to earn your first point!
                            </div>
                        }

                        <!-- Redeem panel -->
                        <div class="redeem-box" style="border-color:@tierBorder;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-arrow-repeat fw-bold" style="color:@tierColor;"></i>
                                <span class="fw-bold" style="font-size:0.88rem; color:#1e293b;">Redeem Points for Sessions</span>
                                <span class="ms-auto redeem-rate-chip">2 pts = 1 session</span>
                            </div>

                            @if (maxRedeemableSessions > 0)
                            {
                                <form asp-controller="Home" asp-action="RedeemPoints" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                                    @Html.AntiForgeryToken()
                                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                                        <label class="small text-muted mb-0 text-nowrap">Sessions to redeem:</label>
                                        <input type="number" name="redeemAmount" id="redeemInput"
                                               class="form-control form-control-sm redeem-input"
                                               min="2" max="@maxRedeemablePoints" step="2"
                                               value="2"
                                               oninput="updateRedeemPreview(this.value)" />
                                    </div>
                                    <div class="redeem-preview small text-muted" id="redeemPreview">
                                        = <strong>1</strong> session
                                    </div>
                                    <button type="submit" class="btn btn-sm redeem-btn"
                                            style="background:@tierColor; color:#fff; border:none;">
                                        <i class="bi bi-lightning-charge-fill me-1"></i>Redeem
                                    </button>
                                </form>
                                <p class="mb-0 mt-2" style="font-size:0.75rem; color:#64748b;">
                                    You can redeem up to <strong>@maxRedeemablePoints pts</strong>
                                    for <strong>@maxRedeemableSessions session(s)</strong> right now.
                                </p>
                            }
                            else
                            {
                                <p class="mb-0 small text-muted">
                                    <i class="bi bi-lock me-1"></i>You need at least <strong>2 points</strong> to redeem a session.
                                    Keep sitting in to earn more!
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- ── LEADERBOARD SECTION ── -->
            <div class="panel-card mb-4">
                <h5 class="panel-title"><i class="bi bi-trophy-fill me-2 text-warning"></i>Student Leaderboard</h5>
                @{
                    var leaderboard = ViewBag.LeaderboardData as List<SignUpLogin.Models.ViewModels.LeaderboardEntryViewModel>
                    ?? new List<SignUpLogin.Models.ViewModels.LeaderboardEntryViewModel>();
                }
                @await Html.PartialAsync("_LeaderboardPartial", leaderboard)
            </div>

        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    <!-- ── Toast container ── -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
        @if (TempData["PointsEarned"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert" data-bs-autohide="true" data-bs-delay="5000">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-star-fill me-2"></i>
                        <strong>+@TempData["PointsEarned"] point(s) earned</strong> for your sit-in session!
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["RedeemSuccess"] != null)
        {
            <div class="toast align-items-center text-bg-primary border-0 show" role="alert" data-bs-autohide="true" data-bs-delay="5000">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-lightning-charge-fill me-2"></i>@TempData["RedeemSuccess"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["RedeemError"] != null)
        {
