@model IEnumerable<SignUpLogin.Models.SitInRecord>
@{
    ViewData["Title"] = "Sit-in History";
    Layout = null;
    // ViewBag.SubmittedFeedbackIds is populated by the Controller
    var submittedIds = ViewBag.SubmittedFeedbackIds as HashSet<int> ?? new HashSet<int>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CCS Student</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    @await Html.PartialAsync("_UserNavBar")

    <div class="dash-wrapper">
        <div class="student-home container py-4 py-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h4 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Sit-in History</h4>
                    <p class="text-muted small mb-0">Complete log of your laboratory sessions</p>
                </div>
                <span class="badge bg-primary rounded-pill fs-6 px-3">@Model.Count() sessions</span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible py-2 small fade show mb-3" role="alert">
                    <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="panel-card">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Laboratory</th>
                                    <th>PC</th>
                                    <th>Purpose</th>
                                    <th>Time In</th>
                                    <th>Time Out</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model)
                                {
                                    var isActive = record.TimeOut == null;
                                    var duration = isActive ? "-" : $"{(int)((record.TimeOut!.Value - record.TimeIn).TotalHours)}h {(record.TimeOut!.Value - record.TimeIn).Minutes}m";
                                    <tr>
                                        <td>@record.TimeIn.ToString("MMM dd, yyyy")</td>
                                        <td>@record.Laboratory</td>
                                        <td>@(string.IsNullOrWhiteSpace(record.PcNumber) ? "-" : record.PcNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(record.Purpose) ? "-" : record.Purpose)</td>
                                        <td class="text-nowrap">@record.TimeIn.ToString("hh:mm tt")</td>
                                        <td class="text-nowrap">@(isActive ? "In Progress" : record.TimeOut!.Value.ToString("hh:mm tt"))</td>
                                        <td>@duration</td>
                                        <td><span class="badge @(isActive ? "text-bg-success" : "text-bg-secondary")">@(isActive ? "Active" : "Completed")</span></td>
                                        <td class="text-center">
                                            @if (!isActive && !submittedIds.Contains(record.Id))
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-sm feedback-btn"
                                                        data-id="@record.Id"
                                                        data-lab="@record.Laboratory"
                                                        data-date="@record.TimeIn.ToString("MMM dd, yyyy")">
                                                    <i class="bi bi-chat-left-text me-1"></i>Feedback
                                                </button>
                                            }
                                            else if (!isActive && submittedIds.Contains(record.Id))
                                            {
                                                <span class="text-muted small"><i class="bi bi-check-circle me-1"></i>Done</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state text-center py-5">
                        <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
                        <h5 class="text-muted">No sit-in sessions yet</h5>
                        <p class="text-muted small">Your session history will appear here after your first sit-in.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    <!-- Feedback Modal -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Home" asp-action="SubmitFeedback" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SitInRecordId" id="modalRecordId" />
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold"><i class="bi bi-chat-left-text me-2 text-primary"></i>Leave Feedback</h6>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-3">
                            Session: <strong id="modalSessionInfo"></strong>
                        </p>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Rating</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="range" class="form-range" id="ratingSlider" name="Rating" min="1" max="5" step="1" value="5" oninput="updateRatingLabel(this.value)">
                                <span id="ratingLabel" class="fw-bold text-warning" style="font-size:1.1rem;">5 ★</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Comments <span class="text-muted">(optional)</span></label>
                            <textarea name="Comment" class="form-control form-control-sm" rows="3" placeholder="How was your experience?"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>Submit Feedback</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const fbModal = new bootstrap.Modal(document.getElementById('feedbackModal'));
        document.querySelectorAll('.feedback-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('modalRecordId').value = btn.dataset.id;
                document.getElementById('modalSessionInfo').textContent = `${btn.dataset.lab} • ${btn.dataset.date}`;
                document.getElementById('ratingSlider').value = 5;
                updateRatingLabel(5);
                fbModal.show();
            });
        });

        function updateRatingLabel(val) {
            const stars = '★'.repeat(val) + '☆'.repeat(5 - val);
            document.getElementById('ratingLabel').textContent = `${val} ${stars}`;
        }
    </script>
</body>
</html>

<style>
    html, body { margin: 0; padding: 0; background: #f3f4f6; }
    body { display: flex; flex-direction: column; min-height: 100vh; }
    .dash-wrapper {
        flex: 1;
    }

    .student-home {
        max-width: 1100px;
    }

    .panel-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 18px;
    }

    .table th {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        font-size: .85rem;
    }

    .empty-state {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 10px;
        padding: 16px;
        color: #475569;
    }

    footer {
        margin-top: 0 !important;
    }
</style>