@model SignUpLogin.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">

    <!-- ── Navbar ── -->
    <nav class="navbar navbar-expand-lg navbar-dark admin-nav sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-semibold" href="#">CCS Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#adminNav" aria-controls="adminNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link active" href="#home">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Students">
                            <i class="bi bi-people me-1"></i>Students
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="SitInRecords">
                            <i class="bi bi-journal-text me-1"></i>Sit-in Records
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Announcements">
                            <i class="bi bi-megaphone me-1"></i>Announcements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Feedback">
                            <i class="bi bi-chat-left-text me-1"></i>Feedback
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Reservations">
                            <i class="bi bi-calendar-check me-1"></i>Reservations
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-warning btn-sm px-3" asp-controller="Admin" asp-action="Logout">
                            Log out
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="admin-main px-4 py-4">

        <!-- ── Page header ── -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-0 fw-bold">Admin Dashboard</h4>
                <p class="text-muted small mb-0">Welcome back, @Model.UserName</p>
            </div>
        </div>

        <!-- ── Stat Cards ── -->
        <section id="home" class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-icon bg-primary-soft text-primary">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <div class="stat-label">Students Registered</div>
                        <div class="stat-value">@Model.StudentsRegistered</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-icon bg-success-soft text-success">
                        <i class="bi bi-display fs-4"></i>
                    </div>
                    <div>
                        <div class="stat-label">Currently Sit-in</div>
                        <div class="stat-value">@Model.CurrentlySitIn</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-icon bg-warning-soft text-warning">
                        <i class="bi bi-journal-richtext fs-4"></i>
                    </div>
                    <div>
                        <div class="stat-label">Total Sit-in Sessions</div>
                        <div class="stat-value">@Model.TotalSitInRecords</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── Sit-in Form + Current Sit-ins ── -->
        <section id="current-sit-in" class="row g-4 mb-4">

            <!-- Sit-in Form -->
            <div class="col-lg-4">
                <div class="module-card h-100">
                    <h5 class="section-title mb-3">
                        <i class="bi bi-person-plus me-2 text-primary"></i>New Sit-in
                    </h5>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible py-2 small fade show" role="alert">
                            <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible py-2 small fade show" role="alert">
                            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form id="sitInForm" asp-controller="Admin" asp-action="SitIn" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">ID Number</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="idNumberInput" name="IdNumber"
                                       class="form-control" placeholder="Enter student ID"
                                       autocomplete="off" />
                                <button type="button" class="btn btn-primary" id="lookupBtn">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <div id="lookupFeedback" class="form-text text-danger d-none">
                                <i class="bi bi-exclamation-circle me-1"></i>Student not found.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Student Name</label>
                            <input type="text" id="studentName" class="form-control form-control-sm bg-light"
                                   readonly placeholder="Auto-populated" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Remaining Sessions</label>
                            <input type="text" id="remainingSessions" class="form-control form-control-sm bg-light"
                                   readonly placeholder="Auto-populated" />
                            <input type="hidden" id="studentIdHidden" name="StudentIdNumber" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Purpose</label>
                            <input type="text" name="Purpose" class="form-control form-control-sm"
                                   placeholder="e.g. C Programming" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Laboratory</label>
                            <select name="Laboratory" id="laboratorySelect" class="form-select form-select-sm" required>
                                <option value="" disabled selected>Select lab</option>
                                <option value="Lab 524">Lab 524</option>
                                <option value="Lab 526">Lab 526</option>
                                <option value="Lab 528">Lab 528</option>
                                <option value="Lab 542">Lab 542</option>
                                <option value="Lab 544">Lab 544</option>
                            </select>
                        </div>

                        <div class="mb-3 d-none" id="pcNumberGroup">
                            <label class="form-label fw-semibold small">PC Number</label>
                            <select name="PcNumber" id="pcNumberSelect" class="form-select form-select-sm">
                                <option value="" disabled selected>Select PC</option>
                            </select>
                        </div>

                        <button type="submit" id="sitInBtn" class="btn btn-success btn-sm w-100" disabled>
                            <i class="bi bi-box-arrow-in-right me-1"></i>Sit In
                        </button>
                    </form>
                </div>
            </div>

            <!-- Active Sit-ins Table -->
            <div class="col-lg-8">
                <div class="module-card h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="section-title mb-0">
                            <i class="bi bi-display me-2 text-success"></i>Current Sit-in
                        </h5>
                        <span class="badge bg-success rounded-pill">@Model.CurrentlySitIn active</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>ID Number</th>
                                    <th>Name</th>
                                    <th>Purpose</th>
                                    <th>Lab</th>
                                    <th>PC No</th>
                                    <th>Time In</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CurrentSitIns.Any())
                                {
                                    @foreach (var sit in Model.CurrentSitIns)
                                    {
                                        <tr>
                                            <td class="text-muted small">@sit.Id</td>
                                            <td>@sit.StudentIdNumber</td>
                                            <td>@(sit.Student is null ? "-" : $"{sit.Student.FirstName} {sit.Student.LastName}")</td>
                                            <td>@(string.IsNullOrWhiteSpace(sit.Purpose) ? "-" : sit.Purpose)</td>
                                            <td>@sit.Laboratory</td>
                                            <td>@(string.IsNullOrWhiteSpace(sit.PcNumber) ? "-" : sit.PcNumber)</td>
                                            <td class="text-nowrap">@sit.TimeIn.ToString("hh:mm tt")</td>
                                            <td><span class="badge text-bg-success">Active</span></td>
                                            <td>
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm close-sitin-btn"
                                                        data-sit-id="@sit.Id"
                                                        data-student-name="@(sit.Student is null ? sit.StudentIdNumber : $"{sit.Student.FirstName} {sit.Student.LastName}")">
                                                    <i class="bi bi-stop-circle me-1"></i>End
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox fs-5 d-block mb-1"></i>No active sit-ins.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── Laboratory Availability ── -->
        <section class="module-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="section-title mb-0">
                    <i class="bi bi-pc-display me-2 text-primary"></i>Laboratory Availability
                </h5>
                <span class="text-muted small">Click a lab to view PCs or update its status</span>
            </div>

            <!-- Status legend -->
            <div class="d-flex flex-wrap gap-3 mb-3">
                <span class="lab-legend lab-legend-available"><span class="lab-legend-dot"></span>Available</span>
                <span class="lab-legend lab-legend-class"><span class="lab-legend-dot"></span>Class is in session</span>
                <span class="lab-legend lab-legend-maintenance"><span class="lab-legend-dot"></span>Maintenance</span>
                <span class="lab-legend lab-legend-unavailable"><span class="lab-legend-dot"></span>Unavailable</span>
            </div>

            <div class="admin-lab-grid">
                @foreach (var lab in Model.LabStatuses)
                {
                    var cardClass = lab.Status.ToLower() switch
                    {
                        "class is in session" => "lab-class",
                        "maintenance" => "lab-maintenance",
                        "unavailable" => "lab-unavailable",
                        _ => "lab-available"   // "Available" + any unknown = green
                    };
                    <div class="admin-lab-card @cardClass"
                         onclick="openLabModal('@lab.LabName', '@lab.Status', '@Html.Raw((lab.Remarks ?? "").Replace("'", "\\'"))')">
                        <div class="admin-lab-name">@lab.LabName</div>
                        <div class="admin-lab-status-row">
                            <span class="admin-lab-dot"></span>
                            <span class="admin-lab-status-text">@lab.Status</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(lab.Remarks))
                        {
                            <div class="admin-lab-remarks">@lab.Remarks</div>
                        }
                        <div class="admin-lab-updated">
                            Updated @lab.UpdatedAt.ToString("MMM dd, hh:mm tt")
                        </div>
                        <div class="admin-lab-hint">
                            <i class="bi bi-display me-1"></i>View / Edit
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- ── Latest Announcements Preview ── -->
        <section class="module-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="section-title mb-0">
                    <i class="bi bi-megaphone me-2 text-warning"></i>Latest Announcements
                </h5>
                <a asp-controller="Admin" asp-action="Announcements" class="btn btn-outline-primary btn-sm">
                    Manage <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            @if (Model.Announcements.Any())
            {
                @foreach (var item in Model.Announcements)
                {
                    <div class="announcement-row">
                        <div class="announcement-meta">
                            <i class="bi bi-person-circle me-1"></i>@item.PostedBy
                            &nbsp;·&nbsp;
                            @item.PostedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>
                        <div class="fw-semibold small">@item.Title</div>
                        <div class="text-muted small">@item.Message</div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted small py-2">
                    <i class="bi bi-info-circle me-1"></i>No announcements posted yet.
                    <a asp-controller="Admin" asp-action="Announcements" class="ms-2">Post one now</a>
                </div>
            }
        </section>

    </main>

    <!-- ════════════════════════════════════════════════════════════════════════
         ── Combined Lab Modal  (PC grid + status editor)
         ════════════════════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="labModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header pb-2">
                    <div>
                        <h6 class="modal-title fw-bold mb-0" id="labModalTitle">
                            <i class="bi bi-pc-display text-primary me-2"></i>
                        </h6>
                        <p class="mb-0 mt-1" style="font-size:.78rem;color:#64748b;">
                            <span class="pc-legend-dot pc-dot-free"></span>&nbsp;Free &nbsp;&nbsp;
                            <span class="pc-legend-dot pc-dot-used"></span>&nbsp;In Use
                        </p>
                    </div>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-4">

                        <!-- Left: PC Grid -->
                        <div class="col-lg-8">
                            <p class="fw-semibold small text-muted mb-2">
                                <i class="bi bi-grid me-1"></i>PC Availability
                            </p>
                            <div id="labPcGrid" class="lab-pc-grid"></div>
                        </div>

                        <!-- Right: Status Editor -->
                        <div class="col-lg-4">
                            <div class="status-editor-box">
                                <p class="fw-semibold small mb-3">
                                    <i class="bi bi-pencil-square me-1"></i>Change Lab Status
                                </p>
                                <form asp-controller="Admin" asp-action="UpdateLabStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" id="labModalNameInput" name="LabName" />
                                    <input type="hidden" id="labModalStatusInput" name="Status" />

                                    <div class="d-grid gap-2 mb-3" id="statusPresetGroup">
                                        <button type="button" class="lab-preset-btn lab-preset-available" data-val="Available">
                                            <span class="preset-dot"></span>Available
                                        </button>
                                        <button type="button" class="lab-preset-btn lab-preset-class" data-val="Class is in session">
                                            <span class="preset-dot"></span>Class is in session
                                        </button>
                                        <button type="button" class="lab-preset-btn lab-preset-maintenance" data-val="Maintenance">
                                            <span class="preset-dot"></span>Maintenance
                                        </button>
                                        <button type="button" class="lab-preset-btn lab-preset-unavailable" data-val="Unavailable">
                                            <span class="preset-dot"></span>Unavailable
                                        </button>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small">
                                            Remarks <span class="text-muted fw-normal">(optional)</span>
                                        </label>
                                        <input type="text" id="labModalRemarksInput" name="Remarks"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. Class until 5 PM" />
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                        <i class="bi bi-check-circle me-1"></i>Save Status
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Confirm End Sit-in Modal ── -->
    <div class="modal fade" id="closeSitInModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-stop-circle text-danger me-2"></i>End Sit-in Session
                    </h6>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2 small">
                    End session for <strong id="closeSitInStudentName"></strong>?
                    The current time will be recorded as the time-out.
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form id="closeSitInForm" asp-controller="Admin" asp-action="EndSitIn" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="closeSitInId" name="sitInId" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-stop-circle me-1"></i>End Session
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    @if (TempData["LoginSuccess"] != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)" id="loginSuccessModal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center p-4">
                    <div class="mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="#28a745" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                    </div>
                    <h5 class="fw-bold">Login Successful!</h5>
                    <p class="text-muted small">@TempData["LoginSuccess"]</p>
                    <button class="btn btn-success mt-2 px-4" onclick="this.closest('.modal').remove()">Continue</button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Occupied PCs map (built from active sit-ins on page load) ──────────
        const occupiedPcsMap = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                Model.CurrentSitIns
                                        .Where(r => r.PcNumber != null)
                                        .GroupBy(r => r.Laboratory)
                                        .ToDictionary(
                                                g => g.Key,
                                                g => g.Select(r => r.PcNumber).ToList()
                                        )
                        )
                );

        // ── Combined Lab Modal ────────────────────────────────────────────────
        const labModal = new bootstrap.Modal(document.getElementById('labModal'));

        function openLabModal(labName, currentStatus, currentRemarks) {
            // Header title
            document.getElementById('labModalTitle').innerHTML =
                '<i class="bi bi-pc-display text-primary me-2"></i>' + labName + ' — PC Availability';

            // Feed hidden fields
            document.getElementById('labModalNameInput').value    = labName;
            document.getElementById('labModalStatusInput').value  = currentStatus;
            document.getElementById('labModalRemarksInput').value = currentRemarks;

            // Highlight matching preset
            document.querySelectorAll('.lab-preset-btn').forEach(btn => {
                btn.classList.toggle('lab-preset-active', btn.dataset.val === currentStatus);
            });

            // Build PC grid
            const used = occupiedPcsMap[labName] || [];
            const grid = document.getElementById('labPcGrid');
            grid.innerHTML = '';
            for (let i = 1; i <= 49; i++) {
                const pcId   = 'PC-' + i;
                const isUsed = used.includes(pcId);
                const card   = document.createElement('div');
                card.className = 'lab-pc-card ' + (isUsed ? 'lab-pc-used' : 'lab-pc-free');
                card.innerHTML =
                    '<div class="lab-pc-icon">&#128187;</div>' +
                    '<div class="lab-pc-label">' + pcId + '</div>' +
                    '<div class="lab-pc-status">' + (isUsed ? 'In Use' : 'Free') + '</div>';
                grid.appendChild(card);
            }

            labModal.show();
        }

        // Preset buttons — update hidden input + active highlight
        document.querySelectorAll('.lab-preset-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('labModalStatusInput').value = btn.dataset.val;
                document.querySelectorAll('.lab-preset-btn').forEach(b => b.classList.remove('lab-preset-active'));
                btn.classList.add('lab-preset-active');
            });
        });

        // ── Sit-in lookup ─────────────────────────────────────────────────────
        const lookupBtn = document.getElementById('lookupBtn');
        const idInput   = document.getElementById('idNumberInput');
        const nameField = document.getElementById('studentName');
        const sessField = document.getElementById('remainingSessions');
        const hiddenId  = document.getElementById('studentIdHidden');
        const sitInBtn  = document.getElementById('sitInBtn');
        const fbk       = document.getElementById('lookupFeedback');
        const labSelect = document.getElementById('laboratorySelect');
        const pcGroup   = document.getElementById('pcNumberGroup');
        const pcSelect  = document.getElementById('pcNumberSelect');

        function resetFields() {
            nameField.value = sessField.value = hiddenId.value = '';
            sitInBtn.disabled = true;
            fbk.classList.add('d-none');
            labSelect.value = '';
            pcGroup.classList.add('d-none');
            pcSelect.innerHTML = '<option value="" disabled selected>Select PC</option>';
            pcSelect.removeAttribute('required');
        }

        async function lookupStudent() {
            const id = idInput.value.trim();
            if (!id) return;
            resetFields();
            try {
                const res  = await fetch(`/Admin/LookupStudent?idNumber=${encodeURIComponent(id)}`);
                const data = await res.json();
                if (data.found) {
                    nameField.value   = data.name;
                    sessField.value   = data.remainingSessions;
                    hiddenId.value    = data.idNumber;
                    sitInBtn.disabled = false;
                } else {
                    fbk.classList.remove('d-none');
                }
            } catch { fbk.classList.remove('d-none'); }
        }

        lookupBtn.addEventListener('click', lookupStudent);
        idInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); lookupStudent(); } });
        idInput.addEventListener('input', resetFields);

        // ── Lab → PC dropdown (skip occupied) ────────────────────────────────
        labSelect.addEventListener('change', async () => {
            pcSelect.innerHTML = '<option value="" disabled selected>Loading…</option>';
            pcGroup.classList.remove('d-none');
            pcSelect.setAttribute('required', 'required');

            if (!labSelect.value) {
                pcGroup.classList.add('d-none');
                pcSelect.removeAttribute('required');
                pcSelect.innerHTML = '<option value="" disabled selected>Select PC</option>';
                return;
            }

            let occupiedPcs = [];
            try {
                const res  = await fetch(`/Admin/GetOccupiedPcs?laboratory=${encodeURIComponent(labSelect.value)}`);
                const data = await res.json();
                occupiedPcs = data.occupiedPcs ?? [];
            } catch { console.warn('Could not fetch occupied PCs; showing all.'); }

            pcSelect.innerHTML = '<option value="" disabled selected>Select PC</option>';
            for (let i = 1; i <= 49; i++) {
                const pcName = `PC-${i}`;
                if (occupiedPcs.includes(pcName)) continue;
                const opt = document.createElement('option');
                opt.value = opt.textContent = pcName;
                pcSelect.appendChild(opt);
            }
            if (pcSelect.options.length === 1) {
                const opt = document.createElement('option');
                opt.disabled = true;
                opt.textContent = 'No PCs available';
                pcSelect.appendChild(opt);
            }
        });

        // ── End Sit-in confirmation ───────────────────────────────────────────
        const closeSitInModal = new bootstrap.Modal(document.getElementById('closeSitInModal'));
        document.querySelectorAll('.close-sitin-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('closeSitInId').value = btn.dataset.sitId;
                document.getElementById('closeSitInStudentName').textContent = btn.dataset.studentName;
                closeSitInModal.show();
            });
        });
    </script>
</body>
</html>

