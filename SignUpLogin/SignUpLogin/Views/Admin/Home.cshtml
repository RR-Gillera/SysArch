@model SignUpLogin.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["ActivePage"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">

    @await Html.PartialAsync("_AdminNavBar")

    <main class="admin-main px-4 py-4">

        <!-- ── Page header ── -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-0 fw-bold">Admin Dashboard</h4>
                <p class="text-muted small mb-0">Welcome back, @Model.UserName</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible py-2 small fade show mb-3" role="alert">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible py-2 small fade show mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- ── Stat Cards ── -->
        <section id="home" class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-icon bg-primary-soft text-primary"><i class="bi bi-person-check fs-4"></i></div>
                    <div><div class="stat-label">Students Registered</div><div class="stat-value">@Model.StudentsRegistered</div></div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-icon bg-success-soft text-success"><i class="bi bi-display fs-4"></i></div>
                    <div><div class="stat-label">Currently Sit-in</div><div class="stat-value">@Model.CurrentlySitIn</div></div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card">
                    <div class="stat-icon bg-warning-soft text-warning"><i class="bi bi-journal-richtext fs-4"></i></div>
                    <div><div class="stat-label">Total Sit-in Sessions</div><div class="stat-value">@Model.TotalSitInRecords</div></div>
                </div>
            </div>
        </section>

        <!-- ── Sit-in Form + Current Sit-ins ── -->
        <section id="current-sit-in" class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="module-card h-100">
                    <h5 class="section-title mb-3"><i class="bi bi-person-plus me-2 text-primary"></i>New Sit-in</h5>
                    <form id="sitInForm" asp-controller="Admin" asp-action="SitIn" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">ID Number</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="idNumberInput" name="IdNumber" class="form-control" placeholder="Enter student ID" autocomplete="off" />
                                <button type="button" class="btn btn-primary" id="lookupBtn"><i class="bi bi-search"></i></button>
                            </div>
                            <div id="lookupFeedback" class="form-text text-danger d-none"><i class="bi bi-exclamation-circle me-1"></i>Student not found.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Student Name</label>
                            <input type="text" id="studentName" class="form-control form-control-sm bg-light" readonly placeholder="Auto-populated" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Remaining Sessions</label>
                            <input type="text" id="remainingSessions" class="form-control form-control-sm bg-light" readonly placeholder="Auto-populated" />
                            <input type="hidden" id="studentIdHidden" name="StudentIdNumber" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Purpose</label>
                            <input type="text" name="Purpose" class="form-control form-control-sm" placeholder="e.g. C Programming" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Laboratory</label>
                            <select name="Laboratory" id="laboratorySelect" class="form-select form-select-sm" required>
                                <option value="" disabled selected>Select lab</option>
                                @foreach (var lab in Model.LabStatuses)
                                {
                                    <option value="@lab.LabName">@lab.LabName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3 d-none" id="pcNumberGroup">
                            <label class="form-label fw-semibold small">PC Number</label>
                            <select name="PcNumber" id="pcNumberSelect" class="form-select form-select-sm"></select>
                        </div>
                        <button type="submit" id="sitInBtn" class="btn btn-success btn-sm w-100" disabled><i class="bi bi-box-arrow-in-right me-1"></i>Sit In</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="module-card h-100">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="section-title mb-0"><i class="bi bi-display me-2 text-success"></i>Current Sit-in</h5>
                        <span class="badge bg-success rounded-pill">@Model.CurrentlySitIn active</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>ID Number</th>
                                    <th>Name</th>
                                    <th>Purpose</th>
                                    <th>Lab</th>
                                    <th>PC No</th>
                                    <th>Time In</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CurrentSitIns.Any())
                                {
                                    @foreach (var sit in Model.CurrentSitIns)
                                    {
                                        <tr>
                                            <td class="text-muted small">@sit.Id</td>
                                            <td>@sit.StudentIdNumber</td>
                                            <td>@(sit.Student is null ? "-" : $"{sit.Student.FirstName} {sit.Student.LastName}")</td>
                                            <td>@(string.IsNullOrWhiteSpace(sit.Purpose) ? "-" : sit.Purpose)</td>
                                            <td>@sit.Laboratory</td>
                                            <td>@(string.IsNullOrWhiteSpace(sit.PcNumber) ? "-" : sit.PcNumber)</td>
                                            <td class="text-nowrap">@sit.TimeIn.ToLocalTime().ToString("hh:mm tt")</td>
                                            <td><span class="badge text-bg-success">Active</span></td>
                                            <td>
                                                <button type="button" class="btn btn-outline-danger btn-sm close-sitin-btn"
                                                        data-sit-id="@sit.Id"
                                                        data-student-name="@(sit.Student is null ? sit.StudentIdNumber : $"{sit.Student.FirstName} {sit.Student.LastName}")">
                                                    <i class="bi bi-stop-circle me-1"></i>End
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox fs-5 d-block mb-1"></i>No active sit-ins.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── Laboratory Availability ── -->
        <section class="module-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="section-title mb-0"><i class="bi bi-pc-display me-2 text-primary"></i>Laboratory Availability</h5>
                <span class="text-muted small">Click a lab to view PCs or update its status</span>
            </div>
            <div class="d-flex flex-wrap gap-3 mb-3">
                <span class="lab-legend lab-legend-available"><span class="lab-legend-dot"></span>Available</span>
                <span class="lab-legend lab-legend-class"><span class="lab-legend-dot"></span>Class is in session</span>
                <span class="lab-legend lab-legend-maintenance"><span class="lab-legend-dot"></span>Maintenance</span>
                <span class="lab-legend lab-legend-unavailable"><span class="lab-legend-dot"></span>Unavailable</span>
            </div>
            <div class="admin-lab-grid">
                @foreach (var lab in Model.LabStatuses)
                {
                    var cardClass = lab.Status.ToLower() switch
                    {
                                "class is in session" => "lab-class",
                                "maintenance" => "lab-maintenance",
                                "unavailable" => "lab-unavailable",
                        _ => "lab-available"
                    };
                    <div class="admin-lab-card @cardClass"
                         onclick="openLabModal('@lab.LabName', '@lab.Status', '@Html.Raw((lab.Remarks ?? "").Replace("'", "\\'"))')">
                        <div class="admin-lab-name">@lab.LabName</div>
                        <div class="admin-lab-status-row"><span class="admin-lab-dot"></span><span class="admin-lab-status-text">@lab.Status</span></div>
                        @if (!string.IsNullOrWhiteSpace(lab.Remarks))
                        {
                            <div class="admin-lab-remarks">@lab.Remarks</div>
                        }
                        <div class="admin-lab-updated">Updated @lab.UpdatedAt.ToString("MMM dd, hh:mm tt")</div>
                        <div class="admin-lab-hint"><i class="bi bi-display me-1"></i>View / Edit</div>
                    </div>
                }

                <!-- Add New Lab Card -->
                <div class="admin-lab-card lab-available" style="border: 2px dashed #0b4a94; background-color: rgba(11, 74, 148, 0.05); display: flex; align-items: center; justify-content: center; flex-direction: column; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#addNewLabModal">
                    <i class="bi bi-plus-circle fs-3 text-primary mb-2"></i>
                    <div class="fw-bold text-primary">Add New Lab</div>
                </div>
            </div>
        </section>

    </main>

    <!-- ── Lab Modal ── -->
    <div class="modal fade" id="labModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header pb-2">
                    <div>
                        <h6 class="modal-title fw-bold mb-0" id="labModalTitle"><i class="bi bi-pc-display text-primary me-2"></i></h6>
                        <p class="mb-0 mt-1" style="font-size:.78rem;color:#64748b;">
                            <span class="pc-legend-dot pc-dot-free"></span>&nbsp;Free &nbsp;&nbsp;
                            <span class="pc-legend-dot pc-dot-used"></span>&nbsp;In Use
                        </p>
                    </div>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <p class="fw-semibold small text-muted mb-2"><i class="bi bi-grid me-1"></i>PC Availability</p>
                            <div id="labPcGrid" class="lab-pc-grid"></div>
                        </div>
                        <div class="col-lg-4">
                            <div class="status-editor-box">
                                <p class="fw-semibold small mb-3"><i class="bi bi-pencil-square me-1"></i>Change Lab Status</p>
                                <form asp-controller="Admin" asp-action="UpdateLabStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" id="labModalNameInput" name="LabName" />
                                    <input type="hidden" id="labModalStatusInput" name="Status" />
                                    <div class="d-grid gap-2 mb-3" id="statusPresetGroup">
                                        <button type="button" class="lab-preset-btn lab-preset-available" data-val="Available"><span class="preset-dot"></span>Available</button>
                                        <button type="button" class="lab-preset-btn lab-preset-class" data-val="Class is in session"><span class="preset-dot"></span>Class is in session</button>
                                        <button type="button" class="lab-preset-btn lab-preset-maintenance" data-val="Maintenance"><span class="preset-dot"></span>Maintenance</button>
                                        <button type="button" class="lab-preset-btn lab-preset-unavailable" data-val="Unavailable"><span class="preset-dot"></span>Unavailable</button>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small">Remarks <span class="text-muted fw-normal">(optional)</span></label>
                                        <input type="text" id="labModalRemarksInput" name="Remarks" class="form-control form-control-sm" placeholder="e.g. Class until 5 PM" />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-check-circle me-1"></i>Save Status</button>
                                </form>

                                <hr class="my-3"/>
                                <form asp-controller="Admin" asp-action="RemoveLaboratory" method="post" onsubmit="return confirm('Are you sure you want to remove this lab? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" id="labModalRemoveNameInput" name="LabName" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-trash3 me-1"></i>Remove Lab</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Confirm End Sit-in Modal ── -->
    <div class="modal fade" id="addNewLabModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Add New Laboratory</h6>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Admin" asp-action="AddLaboratory" method="post">
                    <div class="modal-body pt-3 small">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lab Number / Name</label>
                            <input type="text" name="LabName" class="form-control form-control-sm" placeholder="e.g. 542" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Number of PCs</label>
                            <input type="number" name="TotalPCs" class="form-control form-control-sm" placeholder="e.g. 30" required min="1" max="200" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-circle me-1"></i>Add Lab</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ── Confirm End Sit-in Modal ── -->
    <div class="modal fade" id="closeSitInModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold"><i class="bi bi-stop-circle text-danger me-2"></i>End Sit-in Session</h6>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2 small">End session for <strong id="closeSitInStudentName"></strong>? The current time will be recorded as the time-out.</div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form id="closeSitInForm" asp-controller="Admin" asp-action="EndSitIn" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="closeSitInId" name="sitInId" />
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-stop-circle me-1"></i>End Session</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    @if (TempData["LoginSuccess"] != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)" id="loginSuccessModal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center p-4">
                    <div class="mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="#28a745" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                    </div>
                    <h5 class="fw-bold">Login Successful!</h5>
                    <p class="text-muted small">@TempData["LoginSuccess"]</p>
                    <button class="btn btn-success mt-2 px-4" onclick="this.closest('.modal').remove()">Continue</button>
                </div>
            </div>
        </div>
    }

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // PC Grid & Lab Modal Logic
        const labModal = new bootstrap.Modal(document.getElementById('labModal'));
        const occupiedPcsMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentSitIns.Where(r => r.PcNumber != null).GroupBy(r => r.Laboratory).ToDictionary(g => g.Key, g => g.Select(r => r.PcNumber).ToList())));
        const labPcCountMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabStatuses.ToDictionary(l => l.LabName, l => l.TotalPCs)));

        function openLabModal(labName, currentStatus, currentRemarks) {
            document.getElementById('labModalTitle').innerHTML = '<i class="bi bi-pc-display text-primary me-2"></i>' + labName + ' — PC Availability';
            document.getElementById('labModalNameInput').value = labName;
            document.getElementById('labModalRemoveNameInput').value = labName;
            document.getElementById('labModalStatusInput').value = currentStatus;
            document.getElementById('labModalRemarksInput').value = currentRemarks;
            document.querySelectorAll('.lab-preset-btn').forEach(btn => btn.classList.toggle('lab-preset-active', btn.dataset.val === currentStatus));

            const used = occupiedPcsMap[labName] || [];
            const pcCount = (labPcCountMap[labName] > 0) ? labPcCountMap[labName] : 49;
            const grid = document.getElementById('labPcGrid');
            grid.innerHTML = '';
            for (let i = 1; i <= pcCount; i++) {
                const pcId = 'PC-' + i;
                const isUsed = used.includes(pcId);
                const card = document.createElement('div');
                card.className = 'lab-pc-card ' + (isUsed ? 'lab-pc-used' : 'lab-pc-free');
                card.innerHTML = `<div class="lab-pc-icon">&#128187;</div><div class="lab-pc-label">${pcId}</div><div class="lab-pc-status">${isUsed ? 'In Use' : 'Free'}</div>`;
                grid.appendChild(card);
            }
            labModal.show();
        }

        document.querySelectorAll('.lab-preset-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('labModalStatusInput').value = btn.dataset.val;
                document.querySelectorAll('.lab-preset-btn').forEach(b => b.classList.remove('lab-preset-active'));
                btn.classList.add('lab-preset-active');
            });
        });

        // Sit-in Lookup
        const lookupBtn = document.getElementById('lookupBtn');
        const idInput = document.getElementById('idNumberInput');
        const nameField = document.getElementById('studentName');
        const sessField = document.getElementById('remainingSessions');
        const hiddenId = document.getElementById('studentIdHidden');
        const sitInBtn = document.getElementById('sitInBtn');
        const fbk = document.getElementById('lookupFeedback');
        const labSelect = document.getElementById('laboratorySelect');
        const pcGroup = document.getElementById('pcNumberGroup');
        const pcSelect = document.getElementById('pcNumberSelect');

        function resetFields() { nameField.value = sessField.value = hiddenId.value = ''; sitInBtn.disabled = true; fbk.classList.add('d-none'); labSelect.value = ''; pcGroup.classList.add('d-none'); pcSelect.innerHTML = '<option value="" disabled selected>Select PC</option>'; pcSelect.removeAttribute('required'); }
        async function lookupStudent() { const id = idInput.value.trim(); if (!id) return; resetFields(); try { const res = await fetch(`/Admin/LookupStudent?idNumber=${encodeURIComponent(id)}`); const data = await res.json(); if (data.found) { nameField.value = data.name; sessField.value = data.remainingSessions; hiddenId.value = data.idNumber; sitInBtn.disabled = false; } else { fbk.classList.remove('d-none'); } } catch { fbk.classList.remove('d-none'); } }
        lookupBtn.addEventListener('click', lookupStudent);
        idInput.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); lookupStudent(); } });
        idInput.addEventListener('input', resetFields);

        labSelect.addEventListener('change', async () => {
            pcSelect.innerHTML = '<option value="" disabled selected>Loading…</option>';
            pcGroup.classList.remove('d-none'); pcSelect.setAttribute('required', 'required');
            if (!labSelect.value) { pcGroup.classList.add('d-none'); pcSelect.removeAttribute('required'); pcSelect.innerHTML = '<option value="" disabled selected>Select PC</option>'; return; }
            let occupiedPcs = [];
            try { const res = await fetch(`/Admin/GetOccupiedPcs?laboratory=${encodeURIComponent(labSelect.value)}`); const data = await res.json(); occupiedPcs = data.occupiedPcs ?? []; } catch { }
            pcSelect.innerHTML = '<option value="" disabled selected>Select PC</option>';
            const dropCount = (labPcCountMap[labSelect.value] > 0) ? labPcCountMap[labSelect.value] : 49;
            for (let i = 1; i <= dropCount; i++) { const pcName = `PC-${i}`; if (!occupiedPcs.includes(pcName)) { const opt = document.createElement('option'); opt.value = opt.textContent = pcName; pcSelect.appendChild(opt); } }
            if (pcSelect.options.length === 1) { const opt = document.createElement('option'); opt.disabled = true; opt.textContent = 'No PCs available'; pcSelect.appendChild(opt); }
        });

        const closeSitInModal = new bootstrap.Modal(document.getElementById('closeSitInModal'));
        document.querySelectorAll('.close-sitin-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('closeSitInId').value = btn.dataset.sitId;
                document.getElementById('closeSitInStudentName').textContent = btn.dataset.studentName;
                closeSitInModal.show();
            });
        });
    </script>
</body>
</html>

<style>
    .admin-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #f0f4f8;
    }

    .admin-main {
        flex: 1;
        max-width: 1300px;
        margin: 0 auto;
        width: 100%;
    }

    .admin-nav {
        background: #0a2a6e;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
    }

        .admin-nav .navbar-brand {
            font-size: .95rem;
            color: #fff;
        }

        .admin-nav .nav-link {
            color: rgba(255,255,255,.78);
            font-size: .82rem;
            padding: .4rem .65rem;
            border-radius: 6px;
            transition: background .15s;
        }

            .admin-nav .nav-link:hover, .admin-nav .nav-link.active {
                color: #fff;
                background: rgba(255,255,255,.13);
            }

    .stat-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .bg-primary-soft {
        background: #e8f0fe;
    }

    .bg-success-soft {
        background: #e6f4ea;
    }

    .bg-warning-soft {
        background: #fef9e7;
