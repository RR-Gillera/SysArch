@model IEnumerable<SignUpLogin.Models.SitInRecord>
@{
    ViewData["Title"] = "Sit-in Records";
    ViewData["ActivePage"] = "SitInRecords";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CCS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminNavBar")
    <main class="admin-main px-4 py-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-0 fw-bold"><i class="bi bi-journal-text me-2 text-primary"></i>Sit-in Records</h4>
                <p class="text-muted small mb-0">Complete history of all sit-in sessions</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary rounded-pill fs-6 px-3">@Model.Count() records</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-download me-1"></i>Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ExportSitInCsv"><i class="bi bi-filetype-csv me-2 text-success"></i>Export to CSV</a></li>
                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ExportSitInDocx"><i class="bi bi-filetype-docx me-2 text-primary"></i>Export to DOCX</a></li>
                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ExportSitInPdf"><i class="bi bi-filetype-pdf me-2 text-danger"></i>Export to PDF</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="module-card mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1">Search by Name or ID</label>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="e.g. Juan Dela Cruz or 2021-12345" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Filter by Lab</label>
                    <select id="labFilter" class="form-select form-select-sm">
                        <option value="">All Labs</option>
                        <option>Lab 524</option>
                        <option>Lab 526</option>
                        <option>Lab 528</option>
                        <option>Lab 542</option>
                        <option>Lab 544</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Filter by Status</label>
                    <select id="statusFilter" class="form-select form-select-sm">
                        <option value="">All</option>
                        <option value="active">Active</option>
                        <option value="completed">Completed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" id="clearBtn"><i class="bi bi-x-circle me-1"></i>Clear</button>
                </div>
            </div>
        </div>
        <div class="module-card">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" id="recordsTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>ID Number</th>
                            <th>Student Name</th>
                            <th>Purpose</th>
                            <th>Laboratory</th>
                            <th>PC</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int row = 1;
                            @foreach (var record in Model)
                            {
                                var isActive = record.TimeOut == null;
                                var studentName = record.Student is null ? record.StudentIdNumber : $"{record.Student.FirstName} {record.Student.LastName}".Trim();
                                <tr data-name="@studentName.ToLower()" data-id="@record.StudentIdNumber.ToLower()" data-lab="@record.Laboratory" data-status="@(isActive ? "active" : "completed")">
                                    <td class="text-muted small">@(row++)</td>
                                    <td>@record.StudentIdNumber</td>
                                    <td>@studentName</td>
                                    <td>@(string.IsNullOrWhiteSpace(record.Purpose) ? "-" : record.Purpose)</td>
                                    <td>@record.Laboratory</td>
                                    <td>@(string.IsNullOrWhiteSpace(record.PcNumber) ? "-" : record.PcNumber)</td>
                                    <td class="text-nowrap">@record.TimeIn.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td class="text-nowrap">@(record.TimeOut.HasValue ? record.TimeOut.Value.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt") : "-")</td>
                                    <td>@if (isActive) {
                                    <span class="badge text-bg-success">Active</span>
                                } else
                                {

                                    <span class="badge text-bg-secondary">Completed</span>
                                }
    </td>
                            </tr>
                        }
                                                }
                                                else
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox fs-5 d-block mb-1"></i>No sit-in records found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3 text-muted small">Showing <span id="visibleCount">@Model.Count()</span> of @Model.Count() records</div>
        </div>
    </main>
    @await Html.PartialAsync("_Footer")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const s=document.getElementById('searchInput'),l=document.getElementById('labFilter'),st=document.getElementById('statusFilter'),c=document.getElementById('clearBtn'),tb=document.querySelector('#recordsTable tbody'),vc=document.getElementById('visibleCount');
        function f(){const q=s.value.toLowerCase().trim(),lab=l.value,status=st.value;let n=0;tb.querySelectorAll('tr[data-name]').forEach(r=>{const m=(!q||r.dataset.name.includes(q)||r.dataset.id.includes(q))&&(!lab||r.dataset.lab===lab)&&(!status||r.dataset.status===status);r.style.display=m?'':'none';if(m)n++;});vc.textContent=n;}
        s.addEventListener('input',f);l.addEventListener('change',f);st.addEventListener('change',f);
        c.addEventListener('click',()=>{s.value=l.value=st.value='';f();});
    </script>
</body>
</html>
<style>
    .admin-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #f0f4f8;
    }

    .admin-main {
        flex: 1;
        max-width: 1300px;
        margin: 0 auto;
        width: 100%;
    }

    .admin-nav {
        background: #0a2a6e;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
    }

        .admin-nav .navbar-brand {
            font-size: .95rem;
            color: #fff;
        }

        .admin-nav .nav-link {
            color: rgba(255,255,255,.78);
            font-size: .82rem;
            padding: .4rem .65rem;
            border-radius: 6px;
            transition: background .15s;
        }

            .admin-nav .nav-link:hover, .admin-nav .nav-link.active {
                color: #fff;
                background: rgba(255,255,255,.13);
            }

    .module-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }

    .table th {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        font-size: .85rem;
    }
</style>
