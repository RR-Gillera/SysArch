@{
    ViewData["Title"] = "Analytics";
    ViewData["ActivePage"] = "Analytics";
    Layout = null;
    var sessionsByLab = ViewBag.SessionsByLab as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var leaderboardData = ViewBag.LeaderboardData as List<SignUpLogin.Controllers.LeaderboardEntry>
                          ?? new List<SignUpLogin.Controllers.LeaderboardEntry>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CCS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminNavBar")

    <main class="admin-main px-4 py-4">

        <!-- Header -->
        <div class="mb-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-bar-chart me-2 text-primary"></i>Analytics</h4>
            <p class="text-muted small mb-0">Lab usage overview and student rewards management</p>
        </div>

        <!-- Stat cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary-soft text-primary"><i class="bi bi-journal-richtext fs-4"></i></div>
                    <div>
                        <div class="stat-label">Total Sessions</div>
                        <div class="stat-value">@ViewBag.TotalSessions</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success-soft text-success"><i class="bi bi-display fs-4"></i></div>
                    <div>
                        <div class="stat-label">Active Now</div>
                        <div class="stat-value">@ViewBag.ActiveSessions</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning-soft text-warning"><i class="bi bi-star fs-4"></i></div>
                    <div>
                        <div class="stat-label">Avg Rating</div>
                        <div class="stat-value">@ViewBag.AvgRating <span style="font-size:1rem;color:#f59e0b;">&#9733;</span></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="bi bi-chat-square-text fs-4"></i></div>
                    <div>
                        <div class="stat-label">Total Feedbacks</div>
                        <div class="stat-value">@ViewBag.TotalFeedbacks</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Sessions by Lab -->
            <div class="col-lg-6">
                <div class="module-card h-100">
                    <h6 class="fw-semibold mb-3"><i class="bi bi-pc-display me-2 text-primary"></i>Sessions by Laboratory</h6>
                    @{
                        var labList = sessionsByLab.ToList();
                        int labMax = labList.Any() ? (int)labList.Max(l => (int)(l.Count ?? 0)) : 1;
                    }
                    @if (labList.Any())
                    {
                        @foreach (var item in labList)
                        {
                            double pct = labMax > 0 ? (double)item.Count / labMax * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-semibold">@item.Lab</span>
                                    <span class="small text-muted">@item.Count sessions</span>
                                </div>
                                <div style="height:10px;border-radius:99px;background:#e2e8f0;overflow:hidden;">
                                    <div style="height:100%;border-radius:99px;background:#0b4a94;width:@pct.ToString("0")%;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">No session data yet.</p>
                    }
                </div>
            </div>

            <!-- Add Points Form -->
            <div class="col-lg-6">
                <div class="module-card h-100">
                    <h6 class="fw-semibold mb-3"><i class="bi bi-award me-2 text-warning"></i>Award Points to Student</h6>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible py-2 small fade show" role="alert">
                            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible py-2 small fade show" role="alert">
                            <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                            <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-controller="Admin" asp-action="AddPoints" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Student ID Number</label>
                            <input type="text" name="StudentIdNumber" class="form-control form-control-sm"
                                   placeholder="e.g. 2021-12345" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Points to Add</label>
                            <input type="number" name="Points" class="form-control form-control-sm"
                                   min="1" max="1000" placeholder="e.g. 10" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Reason <span class="text-muted">(optional)</span></label>
                            <input type="text" name="Reason" class="form-control form-control-sm"
                                   placeholder="e.g. Perfect attendance this week" />
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm w-100 fw-semibold">
                            <i class="bi bi-award me-1"></i>Award Points
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Leaderboard -->
        <div class="module-card">
            <h6 class="fw-semibold mb-3"><i class="bi bi-trophy me-2 text-warning"></i>Top Students Leaderboard</h6>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Rank</th>
                            <th>Student</th>
                            <th>Points</th>
                            <th>Total Accumulated</th>
                            <th>Tier</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (leaderboardData.Any())
                        {
                            var sortedByPoints = leaderboardData.OrderByDescending(x => x.Points).ToList();
                            int rank = 1;

                            foreach (var item in sortedByPoints)
                            {
                                string sid = item.StudentIdNumber;
                                string name = string.IsNullOrWhiteSpace(item.StudentName) ? sid : item.StudentName;
                                int pts = item.Points;
                                int totalAccumulated = item.LifetimePoints > 0 ? item.LifetimePoints : item.Points;

                                string tier = totalAccumulated >= 90 ? "Gold" :
                                totalAccumulated >= 60 ? "Silver" :
                                totalAccumulated >= 30 ? "Bronze" : "Starter";

                                string tc = tier == "Gold" ? "#b45309" :
                                tier == "Silver" ? "#475569" :
                                tier == "Bronze" ? "#92400e" : "#6366f1";

                                string rankLabel = rank <= 3 ? rank.ToString() : $"#{rank}";

                                <tr>
                                    <td class="fw-bold">@rankLabel</td>
                                    <td>@name</td>
                                    <td class="fw-bold" style="color:#0b4a94;">@pts</td>
                                    <td class="fw-semibold">@totalAccumulated</td>
                                    <td>
                                        <span style="background:@(tc)22;color:@tc;border:1px solid @(tc)55;padding:2px 8px;border-radius:99px;font-size:.7rem;font-weight:700;">
                                            @tier
                                        </span>
                                    </td>
                                </tr>
                                rank++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-trophy fs-5 d-block mb-1"></i>No data available yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    @await Html.PartialAsync("_Footer")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<style>
    .admin-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #f0f4f8;
    }

    .admin-main {
        flex: 1;
        max-width: 1300px;
        margin: 0 auto;
        width: 100%;
    }

    .admin-nav {
        background: #0a2a6e;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
    }

        .admin-nav .navbar-brand {
            font-size: .95rem;
            color: #fff;
        }

        .admin-nav .nav-link {
            color: rgba(255,255,255,.78);
            font-size: .82rem;
            padding: .4rem .65rem;
            border-radius: 6px;
            transition: background .15s;
        }

            .admin-nav .nav-link:hover, .admin-nav .nav-link.active {
                color: #fff;
                background: rgba(255,255,255,.13);
            }

    .stat-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .bg-primary-soft {
        background: #e8f0fe;
    }

    .bg-success-soft {
        background: #e6f4ea;
    }

    .bg-warning-soft {
        background: #fef9e7;
    }

    .stat-label {
        font-size: .8rem;
        color: #64748b;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.1;
    }

    .module-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }

    .table th {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .table td {
        font-size: .85rem;
    }
</style>
