@model IEnumerable<SignUpLogin.Models.Feedback>
@{
    ViewData["Title"] = "Student Feedback";
    ViewData["ActivePage"] = "Feedback";
    Layout = null;
    double avgRating = Model.Any() ? Model.Average(f => f.Rating) : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CCS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">
    @await Html.PartialAsync("_AdminNavBar")

    <main class="admin-main px-4 py-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-0 fw-bold"><i class="bi bi-chat-left-text me-2 text-primary"></i>Student Feedback</h4>
                <p class="text-muted small mb-0">Sit-in session ratings submitted by students</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="stat-chip">
                    <span class="stat-chip-label">Total Reviews</span>
                    <span class="stat-chip-val">@Model.Count()</span>
                </div>
                <div class="stat-chip">
                    <span class="stat-chip-label">Avg Rating</span>
                    <span class="stat-chip-val">
                        @avgRating.ToString("0.0") <span style="color:#f59e0b;">&#9733;</span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Star distribution -->
        <div class="module-card mb-4">
            <h6 class="fw-semibold mb-3">Rating Distribution</h6>
            <div class="rating-dist">
                @for (int s = 5; s >= 1; s--)
                {
                    int cnt  = Model.Count(f => f.Rating == s);
                    double pct = Model.Any() ? cnt * 100.0 / Model.Count() : 0;
                    <div class="rating-row">
                        <span class="rating-star-lbl">@s &#9733;</span>
                        <div class="rating-bar-track">
                            <div class="rating-bar-fill" style="width:@pct.ToString("0")%;"></div>
                        </div>
                        <span class="rating-cnt">@cnt</span>
                    </div>
                }
            </div>
        </div>

        <!-- Feedback list -->
        <div class="module-card">
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="text" id="fbSearch" class="form-control form-control-sm" placeholder="Search by name or ID…" />
                </div>
                <div class="col-md-3">
                    <select id="fbStarFilter" class="form-select form-select-sm">
                        <option value="">All ratings</option>
                        <option value="5">5 &#9733;</option>
                        <option value="4">4 &#9733;</option>
                        <option value="3">3 &#9733;</option>
                        <option value="2">2 &#9733;</option>
                        <option value="1">1 &#9733;</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" id="fbTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Student</th>
                            <th>ID Number</th>
                            <th>Lab</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int row = 1;
                            @foreach (var fb in Model)
                            {
                                var name = fb.Student is null ? fb.StudentIdNumber
                                           : $"{fb.Student.FirstName} {fb.Student.LastName}".Trim();
                                var lab  = fb.SitInRecord?.Laboratory ?? "-";
                                <tr data-name="@name.ToLower()" data-id="@fb.StudentIdNumber.ToLower()" data-rating="@fb.Rating">
                                    <td class="text-muted small">@(row++)</td>
                                    <td>@name</td>
                                    <td>@fb.StudentIdNumber</td>
                                    <td>@lab</td>
                                    <td>
                                        <span class="stars-display">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span style="color:@(i <= fb.Rating ? "#f59e0b" : "#d1d5db");">&#9733;</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(fb.Comment) ? "—" : fb.Comment)</td>
                                    <td class="text-nowrap small">@fb.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-5 d-block mb-1"></i>No feedback submitted yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    @await Html.PartialAsync("_Footer")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const fbSearch = document.getElementById('fbSearch');
        const fbStar   = document.getElementById('fbStarFilter');
        const tbody    = document.querySelector('#fbTable tbody');

        function filter() {
            const q   = fbSearch.value.toLowerCase().trim();
            const star = fbStar.value;
            tbody.querySelectorAll('tr[data-name]').forEach(r => {
                const matchQ    = !q    || r.dataset.name.includes(q) || r.dataset.id.includes(q);
                const matchStar = !star || r.dataset.rating === star;
                r.style.display = matchQ && matchStar ? '' : 'none';
            });
        }
        fbSearch.addEventListener('input', filter);
        fbStar.addEventListener('change', filter);
    </script>
</body>
</html>
<style>
    .admin-page { min-height:100vh; display:flex; flex-direction:column; background:#f0f4f8; }
    .admin-main { flex:1; max-width:1300px; margin:0 auto; width:100%; }
    .admin-nav  { background:#0a2a6e; box-shadow:0 2px 8px rgba(0,0,0,.18); }
    .admin-nav .navbar-brand { font-size:.95rem; color:#fff; }
    .admin-nav .nav-link { color:rgba(255,255,255,.78); font-size:.82rem; padding:.4rem .65rem; border-radius:6px; transition:background .15s; }
    .admin-nav .nav-link:hover, .admin-nav .nav-link.active { color:#fff; background:rgba(255,255,255,.13); }
    .module-card { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:22px; box-shadow:0 1px 4px rgba(0,0,0,.05); }
    .table th { font-size:.75rem; text-transform:uppercase; letter-spacing:.04em; color:#64748b; font-weight:600; white-space:nowrap; }
    .table td { font-size:.85rem; }
    .stat-chip { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:10px 18px; text-align:center; box-shadow:0 1px 3px rgba(0,0,0,.05); }
    .stat-chip-label { display:block; font-size:.75rem; color:#64748b; }
    .stat-chip-val   { display:block; font-size:1.4rem; font-weight:700; color:#0f172a; }
    .rating-dist { display:flex; flex-direction:column; gap:8px; max-width:420px; }
    .rating-row  { display:flex; align-items:center; gap:10px; }
    .rating-star-lbl { font-size:.85rem; font-weight:600; color:#f59e0b; min-width:36px; }
    .rating-bar-track { flex:1; height:10px; border-radius:99px; background:#e2e8f0; overflow:hidden; }
    .rating-bar-fill  { height:100%; border-radius:99px; background:#f59e0b; }
    .rating-cnt { font-size:.82rem; color:#64748b; min-width:24px; text-align:right; }
</style>
