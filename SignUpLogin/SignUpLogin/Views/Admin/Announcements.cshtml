@model IEnumerable<SignUpLogin.Models.Announcement>
@{
    ViewData["Title"] = "Announcements";
    ViewData["ActivePage"] = "Announcements";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CCS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">

    @await Html.PartialAsync("_AdminNavBar")

    <main class="admin-main px-4 py-4">

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-0 fw-bold"><i class="bi bi-megaphone me-2 text-warning"></i>Announcements</h4>
                <p class="text-muted small mb-0">Post and manage announcements visible to students</p>
            </div>
            <span class="badge bg-secondary rounded-pill fs-6 px-3">@Model.Count() posted</span>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible py-2 small fade show mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible py-2 small fade show mb-3" role="alert">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">

            <!-- Post Form -->
            <div class="col-lg-4">
                <div class="module-card h-100">
                    <h5 class="section-title mb-3">
                        <i class="bi bi-plus-circle me-2 text-primary"></i>Post New Announcement
                    </h5>
                    <form asp-controller="Admin" asp-action="PostAnnouncement" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Title</label>
                            <input type="text" name="Title" class="form-control form-control-sm"
                                   placeholder="Announcement title…" maxlength="120" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Message</label>
                            <textarea name="Message" class="form-control form-control-sm" rows="5"
                                      placeholder="Write your announcement here…" maxlength="1000" required></textarea>
                            <div class="form-text small text-muted">Max 1000 characters.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Posted By</label>
                            <input type="text" name="PostedBy" class="form-control form-control-sm"
                                   value="CCS Admin" maxlength="80" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-send me-1"></i>Post Announcement
                        </button>
                    </form>
                </div>
            </div>

            <!-- Announcements List -->
            <div class="col-lg-8">
                <div class="module-card">
                    <h5 class="section-title mb-3">
                        <i class="bi bi-list-ul me-2"></i>All Announcements
                    </h5>

                    @if (Model.Any())
                    {
                        <div style="max-height: 400px; overflow-y: auto; padding-right: 10px;" class="announcements-list-container">
                            @foreach (var item in Model)
                            {
                                <div class="announcement-card mb-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1 me-3">
                                            <div class="announcement-meta mb-1">
                                                <i class="bi bi-person-circle me-1"></i>@item.PostedBy
                                                &nbsp;·&nbsp;
                                                <i class="bi bi-clock me-1"></i>@item.PostedAt.ToLocalTime().ToString("MMM dd, yyyy · h:mm tt")
                                            </div>
                                            <div class="fw-semibold text-dark">@item.Title</div>
                                            <div class="text-muted small mt-1">@item.Message</div>
                                        </div>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm flex-shrink-0 delete-announcement-btn"
                                                data-id="@item.Id"
                                                data-title="@item.Title">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-4">
                            <i class="bi bi-megaphone fs-3 d-block mb-2 text-muted opacity-50"></i>
                            No announcements yet. Post one using the form.
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <!-- ── Delete Announcement Modal ── -->
    <div class="modal fade" id="deleteAnnouncementModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-trash text-danger me-2"></i>Delete Announcement
                    </h6>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2 small">
                    Delete "<strong id="deleteAnnouncementTitle"></strong>"? This cannot be undone.
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Admin" asp-action="DeleteAnnouncement" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="deleteAnnouncementId" name="id" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteAnnouncementModal'));
        document.querySelectorAll('.delete-announcement-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteAnnouncementId').value          = btn.dataset.id;
                document.getElementById('deleteAnnouncementTitle').textContent = btn.dataset.title;
                deleteModal.show();
            });
        });
    </script>
</body>
</html>

<style>
    .admin-page  { min-height: 100vh; display: flex; flex-direction: column; background: #f0f4f8; }
    .admin-main  { flex: 1; max-width: 1300px; margin: 0 auto; width: 100%; }
    .admin-nav   { background: #0a2a6e; box-shadow: 0 2px 8px rgba(0,0,0,.18); }
    .admin-nav .navbar-brand { font-size: .95rem; color: #fff; }
    .admin-nav .nav-link { color: rgba(255,255,255,.78); font-size: .82rem; padding: .4rem .65rem; border-radius: 6px; transition: background .15s; }
    .admin-nav .nav-link:hover,
    .admin-nav .nav-link.active { color: #fff; background: rgba(255,255,255,.13); }
    .module-card  { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
    .section-title { font-size: .93rem; font-weight: 600; color: #1e293b; }
    .announcement-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px 16px; }
    .announcement-meta { font-size: .75rem; color: #94a3b8; }
</style>
