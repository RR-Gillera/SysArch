@model IEnumerable<SignUpLogin.Models.Signup>
@{
    ViewData["Title"] = "Students";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CCS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="admin-page">

    <!-- ── Navbar ── -->
    <nav class="navbar navbar-expand-lg navbar-dark admin-nav sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-semibold" asp-controller="Admin" asp-action="Home">CCS Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#adminNav" aria-controls="adminNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Home"><i class="bi bi-house-door me-1"></i>Home</a></li>
                    <li class="nav-item"><a class="nav-link active" asp-controller="Admin" asp-action="Students"><i class="bi bi-people me-1"></i>Students</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="SitInRecords"><i class="bi bi-journal-text me-1"></i>Sit-in Records</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Announcements"><i class="bi bi-megaphone me-1"></i>Announcements</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Feedback"><i class="bi bi-chat-left-text me-1"></i>Feedback</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Reservations"><i class="bi bi-calendar-check me-1"></i>Reservations</a></li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-warning btn-sm px-3" asp-controller="Admin" asp-action="Logout">Log out</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="admin-main px-4 py-4">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>Students Information</h4>
                <p class="text-muted small mb-0">Manage registered students</p>
            </div>
            <span class="badge bg-primary rounded-pill fs-6 px-3">@Model.Count() students</span>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible py-2 small fade show mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible py-2 small fade show mb-3" role="alert">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Filter bar -->
        <div class="module-card mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1">Search</label>
                    <input type="text" id="searchInput" class="form-control form-control-sm"
                           placeholder="Name or ID number…" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Course</label>
                    <select id="courseFilter" class="form-select form-select-sm">
                        <option value="">All Courses</option>
                        @foreach (var course in Model.Select(s => s.Course).Distinct().OrderBy(c => c))
                        {
                            <option>@course</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" id="clearBtn">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </button>
                </div>
                <div class="col-md-3 text-md-end">
                    <button class="btn btn-outline-danger btn-sm" id="resetAllSessionsBtn">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Sessions
                    </button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="module-card">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" id="studentsTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>ID Number</th>
                            <th>Name</th>
                            <th>Year Level</th>
                            <th>Course</th>
                            <th>Remaining Sessions</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            int row = 1;
                            @foreach (var s in Model)
                            {
                                <tr data-name="@($"{s.FirstName} {s.LastName}".ToLower())"
                                    data-id="@s.IdNumber.ToLower()"
                                    data-course="@s.Course">
                                    <td class="text-muted small">@(row++)</td>
                                    <td class="fw-medium">@s.IdNumber</td>
                                    <td>@s.FirstName @s.LastName</td>
                                    <td>@s.CourseLevel</td>
                                    <td>@s.Course</td>
                                    <td>
                                        <span class="badge @(s.RemainingSessions > 5 ? "text-bg-success" : s.RemainingSessions > 0 ? "text-bg-warning" : "text-bg-danger") rounded-pill">
                                            @s.RemainingSessions
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-primary btn-sm me-1 edit-student-btn"
                                                data-id="@s.IdNumber"
                                                data-firstname="@s.FirstName"
                                                data-lastname="@s.LastName"
                                                data-courselevel="@s.CourseLevel"
                                                data-course="@s.Course"
                                                data-sessions="@s.RemainingSessions">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm delete-student-btn"
                                                data-id="@s.IdNumber"
                                                data-name="@s.FirstName @s.LastName">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-5 d-block mb-1"></i>No students found.
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3 text-muted small">
                Showing <span id="visibleCount">@Model.Count()</span> of @Model.Count() students
            </div>
        </div>
    </main>

    <!-- ── Edit Student Modal ── -->
    <div class="modal fade" id="editStudentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Admin" asp-action="EditStudent" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h6 class="modal-title fw-bold">
                            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Student
                        </h6>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="IdNumber" id="edit_IdNumber" />

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">First Name</label>
                                <input type="text" name="FirstName" id="edit_FirstName"
                                       class="form-control form-control-sm" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">Last Name</label>
                                <input type="text" name="LastName" id="edit_LastName"
                                       class="form-control form-control-sm" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">Year Level</label>
                                <select name="CourseLevel" id="edit_CourseLevel" class="form-select form-select-sm" required>
                                    <option>1st Year</option>
                                    <option>2nd Year</option>
                                    <option>3rd Year</option>
                                    <option>4th Year</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">Course</label>
                                <input type="text" name="Course" id="edit_Course"
                                       class="form-control form-control-sm" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">Remaining Sessions</label>
                                <input type="number" name="RemainingSessions" id="edit_RemainingSessions"
                                       class="form-control form-control-sm" min="0" max="30" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ── Delete Confirm Modal ── -->
    <div class="modal fade" id="deleteStudentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold">
                        <i class="bi bi-trash text-danger me-2"></i>Delete Student
                    </h6>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2 small">
                    Permanently delete <strong id="deleteStudentName"></strong>? This cannot be undone.
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Admin" asp-action="DeleteStudent" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="deleteStudentId" name="idNumber" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Reset All Sessions Confirm Modal ── -->
    <div class="modal fade" id="resetSessionsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold text-danger">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reset All Sessions
                    </h6>
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2 small">
                    This will reset remaining sessions for <strong>all students</strong> back to the default. Continue?
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Admin" asp-action="ResetAllSessions" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Reset All</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Filtering ──
        const searchInput  = document.getElementById('searchInput');
        const courseFilter = document.getElementById('courseFilter');
        const clearBtn     = document.getElementById('clearBtn');
        const tbody        = document.querySelector('#studentsTable tbody');
        const visibleCount = document.getElementById('visibleCount');

        function filterTable() {
            const q      = searchInput.value.toLowerCase().trim();
            const course = courseFilter.value;
            const rows   = tbody.querySelectorAll('tr[data-name]');
            let count    = 0;
            rows.forEach(row => {
                const match = (!q || row.dataset.name.includes(q) || row.dataset.id.includes(q))
                           && (!course || row.dataset.course === course);
                row.style.display = match ? '' : 'none';
                if (match) count++;
            });
            visibleCount.textContent = count;
        }

        searchInput.addEventListener('input', filterTable);
        courseFilter.addEventListener('change', filterTable);
        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            courseFilter.value = '';
            filterTable();
        });

        // ── Edit modal ──
        const editModal = new bootstrap.Modal(document.getElementById('editStudentModal'));
        document.querySelectorAll('.edit-student-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('edit_IdNumber').value          = btn.dataset.id;
                document.getElementById('edit_FirstName').value         = btn.dataset.firstname;
                document.getElementById('edit_LastName').value          = btn.dataset.lastname;
                document.getElementById('edit_CourseLevel').value       = btn.dataset.courselevel;
                document.getElementById('edit_Course').value            = btn.dataset.course;
                document.getElementById('edit_RemainingSessions').value = btn.dataset.sessions;
                editModal.show();
            });
        });

        // ── Delete modal ──
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteStudentModal'));
        document.querySelectorAll('.delete-student-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('deleteStudentId').value         = btn.dataset.id;
                document.getElementById('deleteStudentName').textContent = btn.dataset.name;
                deleteModal.show();
            });
        });

        // ── Reset sessions modal ──
        const resetModal = new bootstrap.Modal(document.getElementById('resetSessionsModal'));
        document.getElementById('resetAllSessionsBtn').addEventListener('click', () => resetModal.show());
    </script>
</body>
</html>

<style>
    .admin-page  { min-height: 100vh; display: flex; flex-direction: column; background: #f0f4f8; }
    .admin-main  { flex: 1; max-width: 1300px; margin: 0 auto; width: 100%; }
    .admin-nav   { background: #0a2a6e; box-shadow: 0 2px 8px rgba(0,0,0,.18); }
    .admin-nav .navbar-brand { font-size: .95rem; color: #fff; }
    .admin-nav .nav-link { color: rgba(255,255,255,.78); font-size: .82rem; padding: .4rem .65rem; border-radius: 6px; transition: background .15s; }
    .admin-nav .nav-link:hover,
    .admin-nav .nav-link.active { color: #fff; background: rgba(255,255,255,.13); }
    .module-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
    .table th { font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: #64748b; font-weight: 600; white-space: nowrap; }
    .table td { font-size: .85rem; }
</style>
