@model List<SignUpLogin.Models.ViewModels.LeaderboardEntryViewModel>

<div class="module-card">
    <h6 class="fw-semibold mb-3"><i class="bi bi-trophy me-2 text-warning"></i>Top Students Leaderboard</h6>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Rank</th>
                        <th>Student</th>
                        <th>Points</th>
                        <th>Total Accumulated</th>
                        <th>Tier</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                        foreach (var item in Model)
                        {
                            string name = string.IsNullOrWhiteSpace(item.StudentName)
                            ? item.StudentIdNumber : item.StudentName;
                            int pts = item.Points;

                            string tier = pts >= 90 ? "Gold" :
                            pts >= 60 ? "Silver" :
                            pts >= 30 ? "Bronze" : "Starter";

                            string tc = tier == "Gold" ? "#b45309" :
                            tier == "Silver" ? "#475569" :
                            tier == "Bronze" ? "#92400e" : "#6366f1";

                            string rankLabel = rank <= 3 ? rank.ToString() : $"#{rank}";
                            int totalAccumulated = item.LifetimePoints > 0 ? item.LifetimePoints : item.Points;

                            <tr>
                                <td class="fw-bold">@rankLabel</td>
                                <td>@name</td>
                                <td class="fw-bold" style="color:#0b4a94;">@pts</td>
                                <td class="fw-semibold">@totalAccumulated</td>
                                <td>
                                    <span style="background:@(tc)22;color:@tc;border:1px solid @(tc)55;padding:2px 8px;border-radius:99px;font-size:.7rem;font-weight:700;">
                                        @tier
                                    </span>
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted small text-center py-3">No leaderboard data yet.</p>
    }
</div>
